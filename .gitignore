# dependencies
node_modules/
.pnp
.pnp.*

# secrets — never commit; .env.example documents the names
.env
.env*.local

# next.js
.next/
out/
next-env.d.ts

# prisma generated client
packages/db/generated/

# testing
coverage/
test-results/
playwright-report/
blob-report/
.playwright/
.lighthouseci/

# builds
build/
dist/
*.tsbuildinfo

# vercel
.vercel

# claude code — shared settings are tracked, per-machine grants are not
.claude/settings.local.json

# os / editor
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea/

# Added by `vercel link`. Broadened deliberately — it also covers .env.production
# and friends — but it would otherwise swallow .env.example, which is the one
# env file that MUST stay tracked: it documents every variable name and is how
# a fresh clone knows what to set.
.env*
!.env.example
