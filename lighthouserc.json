{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/storage/search?q=78704",
        "http://localhost:3000/storage/tx/austin/demo-austin-south",
        "http://localhost:3000/storage/size-guide"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1,
                "aggregationMethod": "median"
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 3000,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 2500,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/storage/[^/]+/[^/]+/[^/]+$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "structured-data": "off"
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
