# Copy to .env.local (gitignored) and fill in. Names only here — never values.
# Root .env.local is the single source of truth; npm scripts inject it via dotenv-cli.
# Mirror these into Vercel project settings before the first deploy.

# --- Database (Neon Postgres) — B-001/B-002 ---
# Pooled connection used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection used by Prisma Migrate.
DIRECT_URL=

# --- Auth.js — B-003 ---
# Signing key for session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Origin used to build magic-link and password-reset URLs.
AUTH_URL=

# --- Background jobs — B-006 ---
# Shared secret for the /api/cron endpoint. Vercel Cron sends it as a Bearer
# token; the route rejects every request when this is unset.
CRON_SECRET=

# --- Added in later backlog items; listed so nothing is a surprise ---
# Stripe, test mode only (B-019)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Communications — B-030 ---
# Resend API key for transactional email. Unset (dev/test/preview) falls back to
# a log-only provider that records the full Message evidence row but sends no
# real mail — the same honest-degradation posture as STRIPE_SECRET_KEY. A real
# key is used only in production, or in a non-prod env that also sets
# COMMS_SANDBOX_INBOX (below); otherwise a stray key cannot reach a tenant.
# RESEND_API_KEY=
# Sending domain for the From address (needs SPF/DKIM/DMARC set up in DNS).
# COMMS_EMAIL_DOMAIN=mail.example.com
# Org-level kill switch (FR-20). Set to "on" to pause ALL outbound immediately.
# Emergency stop, not a scheduled pause: messages during the pause are not sent
# and are not replayed when it clears.
# COMMS_KILL_SWITCH=
# Non-production safety net (FR-20): with a real RESEND_API_KEY outside
# production, every recipient is rewritten to this inbox so no real tenant can
# be emailed from a preview/staging deploy.
# COMMS_SANDBOX_INBOX=

# --- Stripe — B-019 ---
# Secret API key. Test keys (sk_test_...) everywhere except production.
STRIPE_SECRET_KEY=
# Publishable key for the Payment Element in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret for /api/stripe/webhook, from the Stripe dashboard or
# `stripe listen`. The endpoint refuses every request when this is unset —
# without it we cannot tell a real delivery from anyone else's POST.
STRIPE_WEBHOOK_SECRET=

# --- Gate hardware simulator — B-028 ---
# Signing secret for /api/hardware/webhook. Optional outside production: an
# unset value there gets a random per-process secret automatically, because
# nothing external calls this route yet (only the in-process simulator) — see
# hardwareWebhookSecret()'s own note. Set a real value once a real vendor's
# webhook needs to reach this endpoint (B-085).
# HARDWARE_WEBHOOK_SECRET=

# --- Gate code encryption — B-029 ---
# AES-256-GCM key (32 bytes, hex) for at-rest gate-code storage, so a code can
# later be shown on the confirmation page or revealed to staff. Generate with:
# openssl rand -hex 32
# Unlike HARDWARE_WEBHOOK_SECRET there is no per-process dev fallback — this
# key has to outlive the process that encrypted a code to ever decrypt it
# again. Unset means "no code can be shown," the same honest-degradation
# posture as an unconfigured STRIPE_SECRET_KEY, falling back to "texted
# within 15 minutes."
# ACCESS_CODE_ENCRYPTION_KEY=
