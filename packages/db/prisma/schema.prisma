// Shared schema for the whole platform — master PRD §7.5 (canonical entity
// names) and §7.6 (multi-facility by default).
//
// Invariants enforced repo-wide by tests/schema-invariants.test.ts:
//   - money is Int cents, and every money field is named `...Cents`
//   - every table representing physical or financial reality carries facilityId,
//     directly or through its parent
//   - every timestamp is @db.Timestamptz(6) and stored UTC; facility-local time
//     is a display concern only
//
// Scope note: this is B-002. Entities owned by later items are deliberately
// absent — RoleAssignment (B-004), effective-dated tax/fee schedules (B-008),
// street-rate history (B-011), promo codes and redemptions (B-070),
// DelinquencyTimeline and AuctionRecord (Milestone 5), DrawerSession (B-078).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- enums ----

enum FacilityStatus {
  active
  inactive
}

/// The *effective* status of a unit, shown everywhere and used for filtering.
/// Derived, never free-form (PRD 02 US-8): `occupied` follows lease state,
/// `reserved` follows reservation state, `overlocked` follows the delinquency
/// pipeline. Written only by `recomputeUnitStatus`, never set directly by a
/// human — see OperationalUnitStatus for the part a human controls.
enum UnitStatus {
  available
  reserved
  occupied
  overlocked
  maintenance
  unrentable
}

/// The operator's *intent* for a unit — the only statuses a human may set
/// (PRD 02 US-8), and only while nothing occupies the unit.
///
/// Stored separately from `Unit.status` because effective status alone
/// destroys the intent: a unit marked `maintenance`, then leased, then vacated
/// must return to `maintenance`, not silently to `available`. Collapsing the
/// two into one column loses that, and loses it in the direction that rents
/// out a unit somebody deliberately took offline.
enum OperationalUnitStatus {
  available
  maintenance
  unrentable
}

/// US-14. How a lease ended, which changes what is owed and what evidence
/// backs the date — an abandonment is dated to the last occupancy evidence,
/// not to a tenant's word, and forgives nothing.
enum MoveOutReason {
  tenant_request
  abandonment
}

enum LeaseStatus {
  pending
  active
  delinquent
  pending_auction
  ended
}

enum BillingPolicy {
  anniversary
  first_of_month
}

enum InvoiceKind {
  rent
  fee
}

enum InvoiceStatus {
  draft
  open
  partially_paid
  paid
  void
  uncollectible
}

enum LineItemType {
  rent
  fee
  protection
  tax
  discount
}

enum PaymentMethod {
  card
  ach
  cash
  check
  money_order
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  partially_refunded
}

/// Signed amounts: charge/refund are positive, payment/credit/write_off negative.
/// Posted entries are never edited — corrections are reversing entries (PRD 02 FR-8).
enum LedgerEntryType {
  charge
  payment
  credit
  refund
  adjustment
  write_off
}

enum AccessGrantState {
  pending
  active
  suspended
  revoked
}

enum AccessCredentialType {
  pin
  mobile_key
}

enum AccessCredentialState {
  active
  suspended
  revoked
}

enum HardwareSyncStatus {
  pending
  synced
  failed
}

enum ReservationStatus {
  held
  converted
  cancelled
  expired
}

/// FR-4.1's stepper: details → unit-assign → insurance → lease → payment →
/// provisioned. Stored rather than inferred, so a resumed session lands exactly
/// where the renter left rather than wherever the data happens to imply.
enum CheckoutStep {
  details
  unit_assign
  insurance
  lease
  payment
  provisioned
}

enum CheckoutStatus {
  active
  completed
  /// The 30-minute lock ran out. The session is kept: it is the record of what
  /// the renter had chosen, and B-073's abandonment follow-up reads it.
  expired
  abandoned
}

enum LeadStatus {
  new
  contacted
  reserved
  converted
  lost
}

enum PromotionType {
  percent_off
  amount_off
  free_months
}

enum PromotionStatus {
  draft
  active
  paused
  ended
}

enum PromotionDisplayMode {
  auto
  code
}

enum NoticeType {
  late_notice
  pre_lien
  lien
  auction
  rate_change
  move_out
}

enum NoticeStatus {
  draft
  generated
  delivered
  failed
}

/// Marketing channels require opt-in; account channels are transactional but
/// still respect global suppression (PRD 04 FR-MSG-1, PRD 05 §199).
enum ConsentChannel {
  marketing_email
  marketing_sms
  account_email
  account_sms
  /// PRD 02 US-13 / B-032. Consent to receive *legal notices* by email — not
  /// `account_email` (routine transactional mail) and not marketing. Texas
  /// permits electronic notice only where the tenant agreed to it, so
  /// overloading either of the other two channels would destroy the ability
  /// to prove that specific agreement was ever made.
  notice_email
}

enum ConsentState {
  granted
  revoked
}

// ------------------------------------------------------------- comms (PRD 05) ----

enum MessageChannel {
  email
  sms
}

/// PRD 05 §6.1. Drives the consent/suppression matrix: marketing needs consent
/// and a working unsubscribe; transactional/operational do not, but a hard
/// bounce or complaint still stops delivery on any channel.
enum MessageClassification {
  transactional
  operational
  marketing
}

/// PRD 05 FR-7. Only `email_only` is exercised in MVP (email-first, B-030);
/// the SMS-bearing policies land with Twilio in Phase 2 (B-032+).
enum ChannelPolicy {
  email_only
  sms_only
  both
  sms_preferred_email_fallback
}

/// PRD 05 FR-14 status machine. `bounced`/`delivered` are webhook-driven and
/// arrive with FR-14/15 (a later item); B-030 writes up to `sent`.
enum MessageStatus {
  queued
  sent
  delivered
  bounced
  failed
  suppressed
  cancelled
}

enum SuppressionReason {
  unsubscribe
  stop
  hard_bounce
  complaint
  manual
  /// The org-level kill switch was on when this send was attempted (FR-20).
  kill_switch
}

enum StaffUserStatus {
  active
  suspended
}

enum ActorType {
  staff
  tenant
  system
}

/// US-21's AC: "the fee catalogue covers what a facility actually charges".
/// The last six were added in B-047 — uncharged lock-cut and cleaning is
/// $50–75 per move-out, and a fee with nowhere to post is a fee nobody charges.
enum FeeType {
  admin
  late
  nsf
  lien
  lock_cut
  cleaning
  damage
  transfer
  certified_mail
  auction_cost
}

/// How a late-fee step computes its amount (US-21: "$X or Y% (greater/lesser)").
enum LateFeeBasis {
  flat
  percent
  greater
  lesser
}

/// One auth system, two audiences (master PRD §7.1).
enum AuthAudience {
  tenant
  staff
}

enum AuthTokenPurpose {
  magic_link
  password_reset
  /// Confirms a new email address before it replaces the old one (US-706).
  /// The token's `email` column carries the PENDING address — the change is
  /// not applied anywhere until the link sent to that address is opened,
  /// which is what proves the person asking can actually receive mail there.
  email_change
}

/// Where an address of record came from (PRD 02 US-13).
enum AddressSource {
  portal
  counter
  mail_return
  import
}

// ------------------------------------------------------------ inventory ----

model Facility {
  id                  String         @id @default(cuid())
  name                String
  /// URL segment for location pages; SEO-sensitive, see PRD 04 OQ-7.
  slug                String         @unique
  status              FacilityStatus @default(active)
  addressLine1        String
  addressLine2        String?
  city                String
  /// Two-letter code. Drives compliance config; Texas is the seeded default (D-10).
  state               String
  postalCode          String
  country             String         @default("US")
  latitude            Float?
  longitude           Float?
  /// IANA name, e.g. "America/Chicago". All display time is derived from this.
  timezone            String
  phone               String?
  email               String?
  // ── PRD 04 US-2 (B-067). The marketing profile: the unique content blocks
  // a marketer edits without a deploy. Nullable throughout, and every one of
  // them falls back to the generated default from B-066 — a facility nobody
  // has written copy for still has a title, a description and five true FAQs.
  /// Overrides FR-SEO-3's generated title. ~60 characters is what a result
  /// renders; the editor counts, it does not truncate.
  seoTitle            String?
  /// Overrides the generated meta description. ~155 characters.
  metaDescription     String?
  /// One or two sentences under the facility name. The first thing a renter
  /// reads after the price.
  heroCopy            String?
  /// The long-form unique description. The single biggest lever on whether a
  /// facility page reads as its own page rather than a template with the city
  /// swapped, which is what a thin-content penalty is.
  longDescription     String?
  /// PRD 04 US-5 AC2. When staff last confirmed the Google Business Profile
  /// matches this record. The system flags anything unverified for >90 days.
  /// PRD 02 US-43. How long a new lead may sit uncontacted before it becomes
  /// a task. Business hours are overkill here — a lead is a person waiting for
  /// a call back, and four hours on a Sunday still feels like four hours.
  leadFollowUpHours   Int            @default(4)
  gbpVerifiedAt       DateTime?      @db.Timestamptz(6)
  /// Which checklist items were ticked at that verification. A string array
  /// rather than six booleans: the checklist is US-5 AC1's list today and will
  /// grow, and each addition would otherwise be a migration.
  gbpCheckedItems     String[]       @default([])
  /// PRD 04 US-7 AC1 (B-071). The link the review-request email sends people
  /// to. Null means the request cannot go out at all — a review ask with
  /// nowhere to leave the review is worse than not asking, so the job that
  /// raises requests refuses to for a facility that has not set this.
  googleReviewUrl     String?
  /// US-7 AC1: "N days after move-in completion (default 7, configurable per
  /// facility)." Its own control ships in this item, per this repo's own rule
  /// — a column that changes behaviour with no form field is how five of them
  /// end up reachable only from a database client.
  reviewRequestDelayDays Int         @default(7)
  /// PRD 04 US-9 AC2 (B-073). "Follow-up sequence: +1h, +24h, +72h
  /// (configurable)." The STRUCTURE (three steps) is fixed
  /// (packages/core/checkout/abandonment.ts); this is only the timing, with
  /// its own control shipped in this item per the same repo rule as the
  /// review-request delay above.
  abandonmentFollowUpHours Int[]     @default([1, 24, 72])

  /// PRD 03 FR-3 / US-6. Which gate controller this facility talks to.
  ///
  /// `simulated` is the integrated path (and, per CLAUDE.md and D-4, the only
  /// real driver until there is a controller on a bench). `manual` is the
  /// fallback for a legacy keypad nobody can integrate, or for a vendor outage:
  /// every command becomes a task with the exact keypad action instead.
  gateAdapter         String         @default("simulated")
  /// PRD 03 US-6 AC2: "Overdue manual tasks (configurable, default 4 business
  /// hours) escalate in the dashboard." Business hours, counted against this
  /// facility's own `officeHours` — a task raised at 6pm on Friday is not four
  /// hours overdue on Saturday morning, because nobody was there.
  manualTaskSlaHours  Int            @default(4)
  /// Weekly schedules land in B-008; held as JSON until that item defines them.
  officeHours         Json?
  gateHours           Json?
  amenities           String[]       @default([])
  /// US-44: protection **required** (a proof-of-insurance waiver is still
  /// permitted) vs optional. Texas practice is generally "required, or show
  /// proof", so that is the shipped default — configuration, not law (D-10).
  protectionRequired  Boolean        @default(true)
  /// US-9 AC1: default cap of 3 named people per lease, configurable.
  authorizedAccessCap Int            @default(3)
  /// US-32: a cash payment at or above this needs manager-or-above to take it.
  /// Configuration, not policy — $500 is a starting value, not a rule.
  cashApprovalThresholdCents Int      @default(50000)
  /// US-14 move-out. Whether the final month is prorated to the move-out day,
  /// or the tenant pays through the period they are in. Texas has no statute
  /// either way and "no proration on move-out" is the common lease term, so
  /// that is the shipped default — configuration, not law (D-10).
  prorateOnMoveOut    Boolean        @default(false)
  /// US-17. Whether every lease bills on the 1st, or each on its own move-in
  /// anniversary. **Anniversary is the default (D-27)** — the move-in payment
  /// buys a full period starting that day, so nothing is prorated on the way
  /// in, and the tenant's due date never moves.
  billingPolicy       BillingPolicy  @default(anniversary)
  /// US-17: "invoices generate N days before due (configurable, default 5)".
  invoiceLeadDays     Int            @default(5)
  /// US-18's other half. Only ever reachable under `first_of_month`: under
  /// anniversary billing there is no partial first period to prorate, because
  /// the period starts on the day the tenant moved in.
  prorateOnMoveIn     Boolean        @default(true)
  /// US-20's retry schedule: days AFTER the invoice's original due date on
  /// which a failed autopay is tried again. The default is US-20's own
  /// +1/+3/+5, which with the attempt on the due date itself is four tries.
  /// Empty means one attempt and no retries.
  ///
  /// Offsets from the ORIGINAL due date, never from the last attempt — the
  /// same anchoring rule `daysPastDue` uses (D-25), and for the same reason:
  /// measuring from the previous try stretches the schedule further on every
  /// decline instead of converging.
  paymentRetryDays    Int[]          @default([1, 3, 5])
  /// D-16 / US-45. Days past due at which the tenant's gate access is
  /// suspended. Texas practice is around 6; configuration, not law (D-10).
  /// Zero or less disables the rule entirely, which is a real operator choice.
  accessSuspendDaysPastDue Int       @default(6)
  /// US-28 (B-062). How long an auction surplus is held before it must be
  /// dispositioned — paid to the former tenant, or remitted to the state.
  ///
  /// Configuration, emphatically not law: US-28's own note says the Texas
  /// duration needs an attorney pass under D-10. The default is a placeholder
  /// of the right order of magnitude, and the settings screen says so.
  surplusHoldDays     Int            @default(365)
  /// What counts as a qualifying payment for automatic restore.
  ///
  /// Zero — the default and D-16's decision — means the balance must reach
  /// zero: rent, late fees, everything. Held as a setting rather than a
  /// constant so it can be relaxed without a migration, which is exactly what
  /// D-16 asked for. The rationale for keeping it at zero is in that decision:
  /// any partial-payment rule teaches a tenant to pay the minimum that reopens
  /// the gate, every month, which converts a collections tool into a
  /// subscription for the delinquent.
  accessRestoreAtOrBelowCents Int    @default(0)
  /// US-22's configurable allocation order. Categories from
  /// `packages/core/billing`; a category left out is paid last rather than
  /// never, so a misconfigured order degrades to a worse sequence rather than
  /// making money uncollectable.
  paymentAllocationOrder String[]  @default(["tax", "fee", "protection", "rent"])
  /// PRD 05 CN-3's dunning ladder: days past due at which the tenant is
  /// chased. Empty means no automated chasing, which is a real operator
  /// choice for a site that phones instead.
  dunningDays            Int[]     @default([1, 5, 10, 30])
  /// PRD 05 CN-17. The name a tenant sees in their inbox. Null falls back to
  /// the facility name, which is the sensible default and what shipped before
  /// this was configurable.
  emailFromName          String?
  /// Where a reply goes. The From address stays on the shared authenticated
  /// sending domain — moving it to a facility's own mailbox would break SPF
  /// and DKIM for every send — so the facility's real inbox is reached by
  /// reply-to instead. That split is CN-17's own design.
  emailReplyTo           String?
  /// Days of notice the lease requires before a move-out. 0 means none.
  moveOutNoticeDays   Int            @default(10)
  /// A residual balance at or below this can be written off to close the
  /// lease; anything above needs a manager (US-14's own AC).
  writeOffThresholdCents Int         @default(1000)
  /// D-17. What happens when a tenant's proof of insurance lapses: enrol the
  /// lease into `defaultProtectionTier`, or only raise a staff task.
  ///
  /// Defaults to **false** deliberately. D-17 chose auto-enrolment as the
  /// behaviour and it is built — but the same decision records that it charges
  /// a tenant for a term the lease may not have captured, and "warrants an
  /// attorney pass before it runs against a real tenant". A default of true
  /// would start charging the moment a facility is seeded; false means the
  /// switch is thrown deliberately, per facility, once that pass is done.
  autoEnrolProtectionOnLapse Boolean @default(false)
  /// The `ProtectionPlan.tier` a lapsed waiver enrols into. Null means no tier
  /// has been chosen, and the lapse raises a task rather than a charge even
  /// when the switch above is on.
  defaultProtectionTier String?
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)

  unitTypes              UnitType[]
  units                  Unit[]
  leases                 Lease[]
  invoices               Invoice[]
  payments               Payment[]
  ledgerEntries          LedgerEntry[]
  accessGrants           AccessGrant[]
  accessCredentials      AccessCredential[]
  reservations           Reservation[]
  checkoutSessions       CheckoutSession[]
  protectionPlans        ProtectionPlan[]
  protectionWaivers      ProtectionWaiver[]
  documents              Document[]
  tenantNotes            TenantNote[]
  receiptCounter         ReceiptCounter?
  invoiceCounter         InvoiceCounter?
  tasks                  Task[]
  gateCommands           GateCommand[]
  accessEvents           AccessEvent[]
  marketingFaqs          FacilityFaq[]
  reviews                Review[]
  delinquencyTimelines   DelinquencyTimeline[]
  delinquencyStepRuns    DelinquencyStepRun[]
  overlocks              UnitOverlock[]
  maintenanceTickets     MaintenanceTicket[]
  promoRedemptions       PromoRedemption[]
  analyticsEvents        AnalyticsEvent[]
  photos                 FacilityPhoto[]
  simulatedGateCodes     SimulatedGateCode[]
  simulatedVendorEvents  SimulatedVendorEvent[]
  gateSimulatorConfig    GateSimulatorConfig?
  authorizedAccessPeople AuthorizedAccessPerson[]
  leads                  Lead[]
  notices                Notice[]
  auditLogs              AuditLog[]
  staffAssignments       StaffFacilityAssignment[]
  domainEvents           DomainEvent[]
  jobRuns                JobRun[]
  taxComponents          TaxComponent[]
  lateFeeRules           LateFeeRule[]
  feeSchedules           FeeSchedule[]
  unitTypeRates          UnitTypeRate[]
  messageTemplates       MessageTemplate[]
  noticeTemplates        NoticeTemplate[]
  auctionCases           AuctionCase[]
  notificationRules      NotificationRule[]
  messages               Message[]

  @@index([state])
  @@map("facility")
}

/// A tax jurisdiction component (state/county/city), effective-dated per
/// PRD 02 US-3/FR-9. Rows are never edited or deleted — "changing a rate" is
/// inserting a new row with a later effectiveFrom for the same jurisdiction,
/// so a past invoice's already-generated line items are never touched and a
/// future invoice picks up whichever row's effectiveFrom is the latest one
/// on or before its issue date.
model TaxComponent {
  id              String   @id @default(cuid())
  facilityId      String
  /// Free text, not an enum — jurisdiction names vary by state ("county" in
  /// Texas, "parish" in Louisiana, etc).
  jurisdiction    String
  /// Hundredths of a percent, so 8.25% is stored as 825 — same reasoning as
  /// money-as-cents: percentages with two decimal places need an integer unit
  /// to stay exact.
  rateBasisPoints Int
  effectiveFrom   DateTime @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, jurisdiction, effectiveFrom])
  @@index([facilityId, jurisdiction, effectiveFrom])
  @@map("tax_component")
}

/// Effective-dated per-facility fee amounts (admin/late/NSF/lien), same
/// append-only versioning as TaxComponent. B-047 later adds late-fee *rules*
/// (caps, percentage-vs-flat, grace periods) on top of this baseline amount —
/// deliberately not built here.
model FeeSchedule {
  id            String   @id @default(cuid())
  facilityId    String
  feeType       FeeType
  amountCents   Int
  effectiveFrom DateTime @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, feeType, effectiveFrom])
  @@index([facilityId, feeType, effectiveFrom])
  @@map("fee_schedule")
}

/// US-21. One row per step of a facility's late-fee ladder — "$X or Y%
/// (greater/lesser) at N days late; second fee at M days".
///
/// Effective-dated per step rather than per ladder (FR-9): the group key is
/// `step`, so changing only the second fee inserts one row and leaves the first
/// alone. Rows are never edited, like every other price in this system.
///
/// Separate from `FeeSchedule`, which holds flat amounts for fees a person
/// decides to charge. A late fee is computed from a balance and applied by a
/// job, so it needs a basis, a percentage and a cap that a flat amount cannot
/// express.
model LateFeeRule {
  id                 String       @id @default(cuid())
  facilityId         String
  /// 1 is the first fee, 2 the second. Ordering, not identity.
  step               Int
  /// Days past due at which this step becomes chargeable, measured from the
  /// oldest unpaid rent invoice's ORIGINAL due date (D-25).
  daysPastDue        Int
  amountCents        Int          @default(0)
  /// Hundredths of a percent, so 10% is 1000 — the same unit as tax rates.
  percentBasisPoints Int          @default(0)
  basis              LateFeeBasis @default(flat)
  /// The most this step may ever charge. Null means uncapped, which is a real
  /// operator choice for a flat fee and a dangerous one for a percentage.
  capCents           Int?
  effectiveFrom      DateTime     @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, step, effectiveFrom])
  @@index([facilityId, effectiveFrom])
  @@map("late_fee_rule")
}

model UnitType {
  id                String   @id @default(cuid())
  facilityId        String
  name              String
  widthFt           Int
  lengthFt          Int
  heightFt          Int?
  climateControlled Boolean  @default(false)
  driveUp           Boolean  @default(false)
  floor             Int      @default(1)
  powerAvailable    Boolean  @default(false)
  description       String?
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  facility         Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  units            Unit[]
  reservations     Reservation[]
  checkoutSessions CheckoutSession[]
  leads            Lead[]
  rates            UnitTypeRate[]

  @@unique([facilityId, name])
  @@index([facilityId])
  @@map("unit_type")
}

/// Effective-dated street and web rates per unit type (PRD 02 US-9, FR-9).
/// Append-only, the same pattern as TaxComponent and FeeSchedule: changing a
/// rate inserts a new row rather than editing one, so the rate *history* the
/// AC asks for is simply this table.
///
/// UnitType deliberately carries no current-rate column. A denormalized
/// "current rate" would go stale the moment a future-dated row's date passed,
/// because nothing fires an event when a date arrives — and US-9 requires the
/// website to *always* show the current rate. Resolving at read time makes
/// that true by construction. Volumes are tiny (a facility has tens of unit
/// types and a handful of rate versions each).
///
/// Changing a rate here can never alter an existing lease: Lease.monthlyRateCents
/// is its own column and nothing in this file writes it (US-9 AC).
model UnitTypeRate {
  id              String   @id @default(cuid())
  facilityId      String
  unitTypeId      String
  /// Walk-in / in-store rate.
  streetRateCents Int
  /// Online rate shown by the public site. Commonly lower than street.
  webRateCents    Int
  effectiveFrom   DateTime @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  unitType UnitType @relation(fields: [unitTypeId], references: [id], onDelete: Cascade)

  @@unique([unitTypeId, effectiveFrom])
  @@index([facilityId, effectiveFrom])
  @@index([unitTypeId, effectiveFrom])
  @@map("unit_type_rate")
}

model Unit {
  id                String                @id @default(cuid())
  facilityId        String
  unitTypeId        String
  number            String
  floor             Int                   @default(1)
  /// Optional grouping for the grid view, e.g. "Building A". Null for
  /// single-building sites.
  building          String?
  doorType          String?
  /// Derived. Write through recomputeUnitStatus() only.
  status            UnitStatus            @default(available)
  /// Manually settable, guarded by canSetManualStatus().
  operationalStatus OperationalUnitStatus @default(available)
  /// Coordinates for the grid/map view (B-010).
  mapX              Float?
  mapY              Float?
  notes             String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)

  facility         Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  unitType         UnitType          @relation(fields: [unitTypeId], references: [id], onDelete: Restrict)
  leases           Lease[]
  reservations     Reservation[]
  checkoutSessions CheckoutSession[]

  @@unique([facilityId, number])
  @@index([facilityId, status])
  @@index([unitTypeId])
  /// Grid view groups by building then floor (PRD 02 US-5). `map:` pins the
  /// name to the one the migration created, so schema and database agree.
  @@index([facilityId, building, floor], map: "unit_facility_building_floor")
  @@map("unit")
  overlocks UnitOverlock[]
  maintenanceTickets MaintenanceTicket[]
  auctionCases AuctionCase[]
}

// --------------------------------------------------------- people/leases ----

model Tenant {
  id                           String    @id @default(cuid())
  email                        String    @unique
  /// Optional forever — magic-link sign-in is a first-class path, not just
  /// onboarding (PRD 01 FR-5.1). Never a plaintext or reversible value.
  passwordHash                 String?
  emailVerifiedAt              DateTime? @db.Timestamptz(6)
  /// PRD 05 FR-15. Set when a hard bounce or a spam complaint proves this
  /// address is unusable. A flag rather than clearing the address: the address
  /// is still what we last had, and losing it would make "which address did we
  /// write to" unanswerable — which is exactly the question a lien file asks.
  emailUndeliverableAt         DateTime? @db.Timestamptz(6)
  phone                        String?
  firstName                    String
  lastName                     String
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  state                        String?
  postalCode                   String?
  country                      String?   @default("US")
  /// Self-declared at move-in (US-501 step 1). NOT verification — it is the
  /// flag that tells staff to check before any delinquency action, because
  /// selling an active-duty servicemember's goods without a court order is a
  /// federal problem (SCRA). B-096's LeaseHold is what acts on it; null means
  /// never asked.
  activeDutyMilitary           Boolean?
  altContactName               String?
  altContactPhone              String?
  altContactEmail              String?
  /// Stripe Customer for this tenant. A reference, never card data (master
  /// PRD §7.4 keeps us in SAQ-A: the browser talks to Stripe directly and we
  /// only ever hold tokens).
  stripeCustomerId             String?   @unique
  /// The saved method autopay charges. Set by a SetupIntent; B-025 owns the
  /// enrolment UI, this is the field it writes.
  stripeDefaultPaymentMethodId String?
  createdAt                    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime  @updatedAt @db.Timestamptz(6)
  /// Soft delete only (PRD 02 FR-10); hard delete is never exposed.
  deletedAt                    DateTime? @db.Timestamptz(6)
  /// Optimistic locking (PRD 02 FR-11).
  version                      Int       @default(0)

  leases           Lease[]
  payLinks         PayLink[]
  addresses        TenantAddress[]
  notes            TenantNote[]
  payments         Payment[]
  accessGrants     AccessGrant[]
  reservations     Reservation[]
  checkoutSessions CheckoutSession[]
  leads            Lead[]
  consents         Consent[]
  messages         Message[]

  @@index([lastName, firstName])
  @@map("tenant")
}

/// PRD 02 US-13's address of record. Append-only: a change is a new row, never
/// an edit, and the current address is the newest row.
///
/// Evidentiary, not tidiness. On day 40 of a lien cycle a tenant updates their
/// address in the portal and "which address does the notice go to" has to be
/// answerable from records rather than inference — mailing the old one when
/// they can show they told us is a wrongful sale, mailing the new one when the
/// lease states another may be a failure to use the address of record.
///
/// Each row holds the address as of that moment rather than an old/new pair:
/// the previous row IS the old value, and storing it twice creates two things
/// that can disagree about the same fact. `Tenant.addressLine1` and friends
/// are a cache of the newest row, kept in the same transaction — this table is
/// what a dispute reads (D-21).
model TenantAddress {
  id           String        @id @default(cuid())
  tenantId     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String        @default("US")
  source       AddressSource
  /// Who made the change. Exactly one is set for a human actor; both null
  /// means a system path (an import), which the source already names.
  actorTenantId String?
  actorStaffId  String?
  /// Set when post to this address came back. Makes the tenant's contact
  /// details visibly stale everywhere they render, and B-095 raises the task.
  returnedMailAt DateTime?   @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("tenant_address")
}

/// PRD 02 US-13. "Any staffer can pick up any conversation" — a free-text note
/// on a tenant, visible on the profile regardless of which facility wrote it.
///
/// Immutable by convention: `body` is written once and never updated. A
/// correction is a new row, same as every other append-only record in this
/// schema — the AC's own words are "corrections are new notes." `pinned` is
/// the one exception, and a deliberate one: it is display order, not content,
/// so toggling it does not compromise what the note says or who said it.
model TenantNote {
  id          String   @id @default(cuid())
  tenantId    String
  facilityId  String
  staffUserId String
  body        String
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, pinned, createdAt])
  @@map("tenant_note")
}

model Lease {
  id                 String      @id @default(cuid())
  facilityId         String
  tenantId           String
  unitId             String
  status             LeaseStatus @default(pending)
  startDate          DateTime    @db.Timestamptz(6)
  endDate            DateTime?   @db.Timestamptz(6)
  monthlyRateCents   Int
  /// Day of month rent is billed, 1–28 to stay valid in every month.
  billingDay         Int
  /// PRD 02 US-43 / US-39.3 (B-097). Where this rental came from, stamped at
  /// move-in from the reservation that produced it.
  ///
  /// Denormalised onto the lease deliberately. The chain that knows the answer
  /// — lease → checkout session → reservation → lead — is three joins long and
  /// every link is nullable, so a report walking it would silently under-count
  /// exactly the channels this exists to measure. Null means the lease predates
  /// capture, which `normalizeSource` reports as `unknown` rather than folding
  /// into `web`.
  acquisitionSource  String?
  /// PRD 04 US-7 AC1/AC2 (B-071). "Max 1 review request per tenant per
  /// tenancy." Stamped by the job that raises the request — same device as
  /// `Reservation.expiryReminderSentAt` (B-031): the outbox only dedupes an
  /// event once it exists, so the PRODUCER needs its own marker to guarantee
  /// "once" across a catch-up run that walks several missed nights at once.
  reviewRequestSentAt DateTime? @db.Timestamptz(6)
  /// PRD 02 US-25's AC: "the lease records which timeline version governed it."
  ///
  /// Pinned by B-057 when the lease first becomes delinquent, not at move-in —
  /// a lease that never goes past due is governed by nothing, and pinning at
  /// move-in would freeze a timeline a tenant may never encounter and would
  /// make a later configuration change apply to nobody.
  delinquencyTimelineId String?
  /// PRD 04 US-12 AC2's structured discount instruction, as a relation. Billing
  /// reads the redemption's snapshotted schedule when generating invoices.
  promoRedemption    PromoRedemption?
  /// Whether this unit charges itself each month (PRD 01 US-704).
  ///
  /// Per lease, not per tenant: billing runs per lease (B-045), the portal
  /// dashboard already reports it per unit, and a tenant with two units can
  /// reasonably want one on autopay and one not. WHICH card it charges is a
  /// tenant fact (`Tenant.stripeDefaultPaymentMethodId`) because Stripe's
  /// saved methods belong to the customer — autopay needs both, and either
  /// one missing means nothing is charged automatically.
  ///
  /// Default false so a lease created by any path that has not thought about
  /// autopay does not silently enrol anyone; move-in sets it explicitly from
  /// the renter's own choice at checkout step 5 (§4.6/D-11a: default-on there,
  /// with the disclosure and a one-activation opt-out beside it).
  autopayEnabled     Boolean     @default(false)
  /// US-14 move-out, recorded as three separate facts because they answer
  /// three different questions and routinely disagree: when the tenant said
  /// they were leaving, the last day they had paid for, and the day they
  /// actually vacated. Collapsing them into `endDate` alone loses the ability
  /// to tell a proper notice from an abandonment.
  noticeGivenAt      DateTime?   @db.Timestamptz(6)
  paidThroughDate    DateTime?   @db.Date
  moveOutDate        DateTime?   @db.Date
  moveOutReason      MoveOutReason?
  protectionPlanName String?
  protectionCents    Int         @default(0)
  /// Set when the tenant waives protection, with the attestation text shown.
  protectionWaivedAt DateTime?   @db.Timestamptz(6)
  signedDocumentUrl  String?
  signedDocumentHash String?
  signedAt           DateTime?   @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?   @db.Timestamptz(6)
  version            Int         @default(0)

  facility               Facility                 @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  unit                   Unit                     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  invoices               Invoice[]
  ledgerEntries          LedgerEntry[]
  accessCredentials      AccessCredential[]
  notices                Notice[]
  rateChanges            LeaseRateChange[]
  authorizedAccessPeople AuthorizedAccessPerson[]
  payLinks               PayLink[]
  holds                  LeaseHold[]

  @@index([facilityId, status])
  @@index([tenantId])
  @@index([unitId])
  @@map("lease")
  delinquencyTimeline DelinquencyTimeline? @relation(fields: [delinquencyTimelineId], references: [id], onDelete: SetNull)
  delinquencyStepRuns DelinquencyStepRun[]
  overlocks UnitOverlock[]
  auctionCases AuctionCase[]
}

// -------------------------------------------------------------- billing ----

model Invoice {
  id              String        @id @default(cuid())
  facilityId      String
  leaseId         String
  /// Gapless and sequential per facility; the numbering service is B-044.
  number          String
  status          InvoiceStatus @default(draft)
  issueDate       DateTime      @db.Timestamptz(6)
  dueDate         DateTime      @db.Timestamptz(6)
  /// The service period this invoice bills, half-open: `periodStart` inclusive,
  /// `periodEnd` exclusive, so consecutive invoices tile the calendar with no
  /// day billed twice. Calendar dates, not instants — a tenant occupies a unit
  /// for days, and a timezone here would imply a precision the fact lacks.
  ///
  /// `(leaseId, periodStart)` is the generator's idempotency key, and it is a
  /// database constraint rather than a check-then-insert: the nightly run is
  /// re-runnable and catches up missed dates (FR-4), so "already billed" has
  /// to be unforgeable rather than merely checked.
  periodStart     DateTime      @db.Date
  periodEnd       DateTime      @db.Date
  /// What this invoice is for. `rent` is a recurring service period; `fee` is a
  /// charge raised on its own (B-047's late fees).
  ///
  /// The distinction is load-bearing rather than cosmetic: a fee invoice must
  /// never itself become the base for another late fee, or a facility charges
  /// fees on fees and the balance compounds on its own. Late-fee assessment
  /// reads `rent` invoices only, for both the base amount and the days-past-due
  /// anchor.
  kind            InvoiceKind   @default(rent)
  subtotalCents   Int           @default(0)
  taxCents        Int           @default(0)
  discountCents   Int           @default(0)
  totalCents      Int           @default(0)
  amountPaidCents Int           @default(0)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  facility      Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  lease         Lease               @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  lineItems     InvoiceLineItem[]
  allocations   PaymentAllocation[]
  ledgerEntries LedgerEntry[]

  @@unique([facilityId, number])
  @@unique([leaseId, periodStart])
  @@index([leaseId, dueDate])
  @@index([facilityId, status])
  @@map("invoice")
}

/// Gapless sequential invoice numbers per facility (US-17's AC).
///
/// The same row-lock counter as `ReceiptCounter` (D-22) and for the same
/// reason: a Postgres sequence is unique but NOT gapless, because a rolled-back
/// transaction never returns its number. An invoice series with holes is one an
/// auditor has to be talked through.
model InvoiceCounter {
  facilityId String   @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("invoice_counter")
}

model InvoiceLineItem {
  id              String       @id @default(cuid())
  invoiceId       String
  type            LineItemType
  description     String
  quantity        Int          @default(1)
  unitAmountCents Int
  amountCents     Int
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_item")
}

model Payment {
  id                    String        @id @default(cuid())
  facilityId            String
  tenantId              String
  amountCents           Int
  method                PaymentMethod
  status                PaymentStatus @default(pending)
  /// Token only — card data never touches our servers (master PRD §7.4).
  stripePaymentIntentId String?       @unique
  /// Cash drawer detail; the drawer session itself is B-078.
  tenderedCents         Int?
  changeCents           Int?
  checkNumber           String?
  receivedAt            DateTime      @default(now()) @db.Timestamptz(6)
  failureReason         String?
  /// The provider's machine-readable decline code, e.g. `expired_card`. Kept
  /// beside the human message because they answer different questions: the
  /// message is what a manager reads, and this is what US-20's retry schedule
  /// branches on. A card that has expired must not be retried three more
  /// times, and deciding that by matching on prose would be a bug waiting for
  /// Stripe to reword something.
  failureCode           String?
  /// Set on a refund payment, pointing at the payment being refunded.
  refundOfPaymentId     String?
  /// US-32 attribution. The staff member who physically took the money, read
  /// from the session actor and never from a form field. Required for cash,
  /// check and money order (enforced in `lib/admin/pos.ts`, not by the column,
  /// because a card payment taken online legitimately has no one behind the
  /// counter). A cash payment with a facility, a timestamp and no human
  /// attached is how money walks out of a storage facility unnoticed.
  receivedByStaffId     String?
  /// US-32: gapless per-facility receipt number, assigned in the same
  /// transaction as the payment (see ReceiptCounter). Null for payments that
  /// never went through a counter — the Stripe-driven online path — because a
  /// receipt book with holes where the web rentals were is not gapless, it is
  /// just confusing.
  receiptNumber         Int?
  createdAt             DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(6)

  facility       Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receivedByStaff StaffUser?         @relation(fields: [receivedByStaffId], references: [id], onDelete: Restrict)
  refundOf       Payment?            @relation("PaymentRefund", fields: [refundOfPaymentId], references: [id], onDelete: Restrict)
  refunds        Payment[]           @relation("PaymentRefund")
  allocations    PaymentAllocation[]
  ledgerEntries  LedgerEntry[]
  payLink        PayLink?

  @@unique([facilityId, receiptNumber])
  @@index([facilityId, receivedAt])
  @@index([tenantId])
  @@map("payment")
}

/// US-32's gapless receipt numbering, one row per facility.
///
/// Gapless is a stronger guarantee than a Postgres sequence gives: a sequence
/// does not roll back, so an aborted transaction leaves a hole. Here the
/// number is handed out by an UPDATE ... RETURNING inside the same
/// transaction that writes the payment, so the row lock serialises concurrent
/// counter staff AND a rollback returns the number to the pool. A hole in a
/// receipt book is the thing an auditor asks about.
model ReceiptCounter {
  facilityId String   @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("receipt_counter")
}

/// A payment can settle several invoices; allocation order is configurable in B-048.
model PaymentAllocation {
  id          String   @id @default(cuid())
  paymentId   String
  invoiceId   String
  amountCents Int
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocation")
}

/// Append-only. Posted entries are never mutated; a correction is a new entry
/// with reversalOfId set (PRD 02 FR-8).
/// Every Stripe webhook we have accepted, keyed by Stripe's own event id.
///
/// Stripe delivers at-least-once and retries a non-2xx for days, so the same
/// event WILL arrive twice — the unique primary key is what makes handling it
/// twice a no-op rather than a double-posted payment. Rows are kept after
/// processing: they are the reconciliation trail between Stripe and the ledger
/// (PRD 01 §7.3), and the only way to answer "did we ever see this event".
/// PRD 01 FR-4.1. A move-in in progress.
///
/// Deliberately NOT a Reservation. Reusing the reservation row as the checkout
/// lock would be less code, and it would make every abandoned checkout look
/// like a reservation — which silently corrupts the reservation→move-in
/// conversion report the whole funnel is judged on. A hold someone asked for
/// and a lock the system took while they type are different events.
model CheckoutSession {
  id              String         @id @default(cuid())
  facilityId      String
  unitTypeId      String
  /// The specific unit this session is holding. Claimed the same way a
  /// reservation claims one (FOR UPDATE SKIP LOCKED), and released when the
  /// lock lapses.
  unitId          String?
  /// Set when the renter came from a free hold, so completing does not leave a
  /// stale reservation behind and abandoning does not release a unit they had
  /// already been promised.
  reservationId   String?
  tenantId        String?
  step            CheckoutStep   @default(details)
  status          CheckoutStatus @default(active)
  /// FR-4.1: the resume link is the session's signed token, emailed once the
  /// address is captured at step 1. Only the hash is stored.
  tokenHash       String         @unique
  /// Captured at step 1 and held here so the resume email can be sent before a
  /// Tenant row exists.
  email           String?
  /// Rate seen = rate charged. Locked at the moment the session started, so a
  /// rate change mid-checkout cannot move the total under the renter.
  quotedRateCents Int
  /// PRD 04 US-12 AC2 (B-070). The promotion carried from the facility page
  /// through checkout, so the discounted first-invoice figure shown before
  /// payment is the one that gets redeemed. Held on the session rather than
  /// re-evaluated at each step: a promo that ended mid-checkout must not
  /// silently change the total somebody already read.
  promotionId     String?
  promoCodeId     String?
  /// The 30-minute unit lock. Extended by the heartbeat and by an explicit
  /// "keep it" from the renter (2.2.1).
  lockExpiresAt   DateTime       @db.Timestamptz(6)
  /// Per-step captured data, merged as the renter advances. Typed at the edges
  /// by the step schemas in B-021..B-025 rather than here.
  data            Json           @default("{}")
  /// PRD 04 US-9 AC1/AC2 (B-073). How far the abandonment follow-up has
  /// reached: 0 = never entered, 1–3 = that step has been raised. Same device
  /// as `Lead.dripStep` — the outbox only dedupes an event that already
  /// exists, so guaranteeing each step fires once is the producer's job.
  /// Deliberately NOT tracked via `CheckoutStatus`'s own `abandoned` value:
  /// that would risk a slow-but-still-`active` renter's live session being
  /// mutated out from under them the moment the first follow-up fires.
  abandonmentSequenceStep Int    @default(0)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  unitType    UnitType     @relation(fields: [unitTypeId], references: [id], onDelete: Restrict)
  unit        Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([facilityId, status])
  @@index([status, lockExpiresAt])
  /// One live session per unit, enforced in raw SQL because Prisma cannot
  /// express a partial index (migration 20260801120000_checkout_session):
  ///   checkout_session_one_active_per_unit — unique(unitId) where status='active'
  @@map("checkout_session")
}

/// PRD 02 US-44. A coverage tier the operator sells.
///
/// What we sell is a **protection plan**, not insurance: "insurance" describes
/// cover the tenant already holds somewhere else. The two words are not
/// interchangeable in copy, in this schema, or on an invoice — selling actual
/// insurance generally requires a licensed agent, which is exactly why the
/// industry sells an addendum instead.
///
/// Effective-dated like every other price here (FR-9): rows are never edited,
/// and changing a premium means inserting a new row with a later
/// `effectiveFrom`. `tier` is the grouping key so renaming the display name
/// does not fork the price history.
model ProtectionPlan {
  id            String   @id @default(cuid())
  facilityId    String
  tier          String
  name          String
  coverageCents Int
  premiumCents  Int
  effectiveFrom DateTime @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, tier, effectiveFrom])
  @@index([facilityId, effectiveFrom])
  @@map("protection_plan")
}

/// PRD 02 US-44. The evidence behind a waiver.
///
/// The failure this exists to prevent: the tenant waives by claiming their own
/// cover, nobody ever sees the declaration page, the policy lapses eight months
/// later, the unit floods, and the operator is in a coverage argument with no
/// record. A structured row with an expiry date is what makes D-17's lapse scan
/// possible at all.
model ProtectionWaiver {
  id                String    @id @default(cuid())
  facilityId        String
  /// Set once the lease exists (B-026). Until then the waiver belongs to the
  /// checkout session that captured it.
  leaseId           String?   @unique
  checkoutSessionId String?   @unique
  tenantId          String?
  carrier           String?
  policyNumber      String?
  /// What D-17's nightly scan looks at. Null only on a manager override.
  expiresAt         DateTime? @db.Timestamptz(6)
  /// Reference to the uploaded declaration page (US-16's document store).
  documentRef       String?
  /// The counter case: the tenant will not produce a declaration page and a
  /// manager accepts the waiver anyway. Audit-logged by the caller.
  overrideReason    String?
  overrideByStaffId String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId, expiresAt])
  @@map("protection_waiver")
}

/// PRD 02 US-16 / FR-6. THE document store — one, not one per feature.
///
/// US-16 is explicit about why: "three URL columns on three entities is how the
/// evidence chain ends up with three retention policies and two of them wrong."
/// Lease PDFs, notices, walkthrough photos, overlock photos, auction evidence
/// and proof-of-insurance declaration pages all land here.
model Document {
  id          String       @id @default(cuid())
  facilityId  String
  type        DocumentType
  /// What the document is about. Deliberately loose strings rather than six
  /// nullable FKs: a document store that needs a migration for every new kind
  /// of subject stops being one store.
  subjectType String
  subjectId   String
  title       String
  /// The rendered document itself, when we generated it. Generated documents
  /// are HTML — see lib/documents/render.ts for why that is the canonical form
  /// rather than a PDF.
  content     String?
  /// Where the bytes live for an uploaded file. Null for generated documents.
  /// No blob store is configured yet (B-023 note), so nothing writes this.
  storageRef  String?
  mimeType    String
  byteSize    Int?
  /// SHA-256 over the exact bytes or content that were signed or delivered.
  /// This is the evidence half of e-signature (PRD 01 FR-4.2): a lease whose
  /// hash no longer matches is a lease that changed after signing.
  contentHash String
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  /// Soft delete only, admin-only, audit-logged (US-16). Evidence is not
  /// something a mis-click removes.
  deletedAt   DateTime?    @db.Timestamptz(6)

  facility  Facility           @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  signature DocumentSignature?
  notices   Notice[]
  auctionInventories AuctionCase[]

  @@index([facilityId, type])
  @@index([subjectType, subjectId])
  @@map("document")
}

/// PRD 01 FR-4.2. The evidence that someone signed a specific document.
///
/// E-SIGN/UETA does not ask for a picture of a signature; it asks whether the
/// signer consented to do business electronically, whether the record is
/// attributable to them, and whether it has been retained unaltered. So this
/// stores the consent, the attribution and the hash of exactly what was on
/// screen — not an image.
model DocumentSignature {
  id                           String   @id @default(cuid())
  documentId                   String   @unique
  /// Typed name, exactly as the signer entered it. Compared against the name on
  /// the lease at signing time, not normalised afterwards.
  typedName                    String
  /// Separate from the signature itself: consent to transact electronically is
  /// its own affirmative act under E-SIGN, not something the signature implies.
  consentedToElectronicRecords Boolean
  /// What the signer's browser reported. Best-effort attribution, not identity.
  ipAddress                    String?
  userAgent                    String?
  /// The hash of the document as rendered at the moment of signing. If the
  /// stored document ever stops matching this, the signature no longer covers
  /// what is on file — which is the entire point of recording it separately
  /// from Document.contentHash.
  signedContentHash            String
  signedAt                     DateTime @default(now()) @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@map("document_signature")
}

enum DocumentType {
  lease
  receipt
  notice
  insurance_proof
  id_copy
  inspection_photo
  lien_evidence
  other
}

/// PRD 02 US-11. Every change to a lease's in-place rate, with why.
///
/// Written from the very first lease (B-026), and that timing is the entire
/// point. ECRI — raising an existing tenant's rate — is the largest revenue
/// lever in self-storage, and it needs two facts: when this tenant was last
/// raised, and how far below street they are. Neither can be reconstructed
/// afterwards, so a lease created without a history row is a tenant who is
/// permanently ineligible for a rules-based increase. B-076 builds the
/// workflow; this is the clock it reads, started early on purpose.
model LeaseRateChange {
  id                String          @id @default(cuid())
  leaseId           String
  previousRateCents Int?
  newRateCents      Int
  effectiveFrom     DateTime        @db.Timestamptz(6)
  reason            LeaseRateReason
  /// Null for a system-initiated change (move-in, a scheduled ECRI batch).
  actorStaffId      String?
  /// Days of notice given, where the reason required any.
  noticeDays        Int?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@index([leaseId, effectiveFrom])
  @@map("lease_rate_change")
}

enum LeaseRateReason {
  move_in
  ecri
  transfer
  promo_expiry
  manual
}

/// PRD 03 FR-3. The command outbox between us and a gate controller.
///
/// Every write to hardware goes through here rather than being called inline.
/// A gate controller is a box in a car park on a domestic broadband line: it is
/// offline sometimes, slow often, and a move-in must never depend on its uptime
/// (PRD 01 US-501). So the service records what it wants to happen and returns;
/// the drain does the talking and retries.
model GateCommand {
  id             String            @id @default(cuid())
  facilityId     String
  grantId        String?
  credentialId   String?
  type           GateCommandType
  /// Deduplicates retries and redeliveries. Derived from what the command is
  /// FOR — the same rule the Stripe idempotency keys follow — so asking twice
  /// for the same effect is one command, not two.
  idempotencyKey String            @unique
  payload        Json
  status         GateCommandStatus @default(pending)
  attempts       Int               @default(0)
  lastError      String?
  /// Exponential backoff, so a controller that is down does not get hammered.
  nextAttemptAt  DateTime          @default(now()) @db.Timestamptz(6)
  /// Set when we stop retrying. A dead-lettered command is a staff alert
  /// (FR-3), never a silent failure — somebody has to key the code in by hand.
  deadLetteredAt DateTime?         @db.Timestamptz(6)
  completedAt    DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([facilityId, status])
  @@map("gate_command")
}

enum GateCommandType {
  grant_access
  revoke_access
  suspend_access
  resume_access
  set_credential
  /// PRD 03 US-4 AC1/AC2: where the adapter reports `timeWindows: true`,
  /// enforcement is hardware-side, so the schedule has to reach the controller
  /// rather than being checked here. Editing a facility's gate hours
  /// propagates one of these per active grant.
  set_time_window
}

enum GateCommandStatus {
  pending
  succeeded
  failed
  dead_lettered
  /// PRD 03 US-6. Handed to a human: the ManualAdapter turned this command into
  /// a `Task` and there is nothing more the software can do until somebody
  /// walks to the keypad. Distinct from `pending` because the retry loop must
  /// NOT keep re-sending it — five retries would make five tasks — and distinct
  /// from `dead_lettered` because nothing has gone wrong.
  awaiting_manual
}

/// PRD 03 FR-4 (minimal slice) / US-7 AC2. A real access event, produced by
/// the same webhook path a vendor integration would use.
///
/// Deliberately small: dedup, normalization, the admin event log and anomaly
/// flags are FR-4's fuller pipeline and belong to B-064, which depends on this
/// item. What B-028 owes is that the event exists and arrived through a
/// signed webhook — everything downstream builds on top of this row.
model AccessEvent {
  id            String            @id @default(cuid())
  facilityId    String
  /// What the vendor calls this event. The dedup key (FR-4: "dedup by
  /// (facilityId, vendorEventId)") — a redelivered webhook must not double-log
  /// a gate open.
  vendorEventId String            @unique
  /// Null when the code presented does not match anything on file — "unknown
  /// code" is itself retained (FR-4), never discarded, because a stranger
  /// trying codes at a gate is exactly the pattern a later anomaly flag reads.
  credentialId  String?
  result        AccessEventResult
  reason        String
  /// PRD 03 US-5 AC3's anomaly flags, computed at ingestion (see
  /// packages/core/access/anomalies.ts) rather than derived on read.
  ///
  /// Stored because the flag is evidence: what the system thought at the time
  /// is what a manager is later asked about, and a flag recomputed under
  /// today's thresholds would quietly rewrite that. `denied_repeated` also
  /// depends on a window of neighbouring events, which is not something to
  /// re-derive per row on every page of a filtered list.
  flags         String[]          @default([])
  occurredAt    DateTime          @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)

  facility   Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  credential AccessCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([facilityId, occurredAt])
  @@index([credentialId, occurredAt])
  @@map("access_event")
}

enum AccessEventResult {
  granted
  denied
}

/// PRD 03 US-7. The mock vendor's own database — deliberately separate from
/// `AccessCredential`, which by design (SR-2) never stores the plaintext code.
/// A real vendor's controller holds the code; we hold only a reference to it.
/// This table exists to play that vendor's part in the simulation, and a real
/// integration would have no equivalent row on our side at all.
/// PRD 04 FR-AN-2 (B-069). The server-side event log — the funnel's source of
/// truth.
///
/// "Immune to ad blockers/consent declines." Between a fifth and a third of
/// visitors block third-party analytics, and that share correlates with the
/// channel — so a funnel built on client events would under-count unevenly, and
/// an owner would compare channels using numbers biased by how technical each
/// channel's audience is.
///
/// Nothing here identifies a person. `sessionId` is a first-party random id
/// with no account behind it, which is what makes AC5's "server-side funnel
/// events (first-party, pseudonymous) remain the reporting fallback when
/// consent is declined" true rather than aspirational.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  /// One of `ANALYTICS_EVENTS` (packages/core/analytics). A loose string for
  /// the usual reason: a new event is a catalog entry, not a migration.
  name       String
  facilityId String?
  /// Pseudonymous, first-party, and rotated per browser session. Never a user
  /// id and never derived from one.
  sessionId  String
  /// The marketing channel at the time of the event, so the funnel can be
  /// split by source without joining back to a lead that may not exist.
  channel    String?
  utmSource  String?
  utmMedium  String?
  path       String?
  /// Event-specific detail. Deliberately small and never PII — a funnel row is
  /// a count, and anything richer belongs on the entity it describes.
  properties Json?
  occurredAt DateTime @default(now()) @db.Timestamptz(6)

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  @@index([facilityId, occurredAt])
  @@index([name, occurredAt])
  @@index([sessionId])
  @@map("analytics_event")
}

/// PRD 04 FR-LEAD-1 (B-068). "New inquiries appended as activities rather than
/// duplicate leads."
///
/// The same person asking twice in a fortnight is one lead with two things to
/// say, not two leads — and two leads means two staff calling them, which is
/// the outcome the dedup rule exists to prevent. Each repeat ask lands here.
model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  /// `inquiry` for a repeat form submission, `note` for anything a staffer
  /// adds. A loose string for the usual reason — a new kind is a value, not a
  /// migration.
  type      String   @default("inquiry")
  body      String
  /// The attribution of THIS ask, which may differ from the lead's first
  /// touch: somebody who arrived organically in March and clicked an ad in
  /// April is one lead whose second visit was paid.
  channel   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activity")
}

/// PRD 04 US-2 AC1 (B-067). A facility's own FAQ, question by question.
///
/// A table rather than JSON on `Facility` because these are individually
/// ordered, individually edited, and individually rendered into `FAQPage`
/// structured data — all three of which are awkward against a JSON blob and
/// none of which needs a join anywhere else.
///
/// A facility with no rows here falls back to `defaultFacilityFaqs` (B-066),
/// so US-1 AC2's "at least 5" holds whether or not anybody has written any.
model FacilityFaq {
  id         String   @id @default(cuid())
  facilityId String
  question   String
  answer     String
  /// Display order, ascending. Sparse on purpose (10, 20, 30…) so inserting
  /// between two entries does not renumber the rest.
  position   Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, position])
  @@map("facility_faq")
}

enum ReviewSource {
  manual_google
  manual_other
  /// FR-REV-4 (Phase 3). Nothing produces this yet — no Google Places/GBP API
  /// integration exists in this codebase. Reserved now because
  /// `qualifiesForSchemaMarkup` (packages/core/reviews) checks for it, and the
  /// gate is easier to trust when it names the value it is waiting for.
  google_api
}

/// PRD 04 §3.4 FR-REV-1/FR-REV-2 (B-071). A review shown on a facility page.
///
/// Immutable content, same convention as `TenantNote`: "corrections are new
/// notes," not edits. Here it is "hide, never edit" — `visible` is the one
/// field a moderation action may change, because it is display order, not the
/// content of what somebody said. A hidden review's rating and text stay
/// exactly what was entered; if a review was mistranscribed the fix is to hide
/// it and create the corrected one, not to rewrite what a citation of it would
/// have quoted.
model Review {
  id                  String       @id @default(cuid())
  facilityId          String
  rating              Int
  text                String
  reviewerDisplayName String
  /// When the review was actually posted, not when staff transcribed it — "5
  /// most recent reviews" (US-6 AC1) has to sort by the real date.
  reviewDate          DateTime     @db.Date
  source              ReviewSource @default(manual_google)
  visible             Boolean      @default(true)
  createdByStaffId    String?
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, visible, reviewDate])
  @@map("review")
}

/// PRD 04 US-2 AC1 (B-067). Facility photos, with alt text that is not optional.
///
/// `alt` is a required column rather than a nullable one with a lint rule,
/// because WCAG 1.1.1 is an acceptance criterion on customer-facing work here
/// and a photo set where three of eleven have alt text is the normal outcome of
/// making it optional.
///
/// No blob store is configured yet (the same B-023 note `Document.storageRef`
/// carries), so `url` is a reference to wherever the operator's photos already
/// live. When an upload path exists it writes this same column.
model FacilityPhoto {
  id         String            @id @default(cuid())
  facilityId String
  url        String
  /// Required. WCAG 1.1.1, and also what makes the image findable.
  alt        String
  kind       FacilityPhotoKind @default(other)
  position   Int
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, position])
  @@map("facility_photo")
}

/// The shot types PRD 01 US-103 asks for by name: "exterior, gate, hallway,
/// sample unit, security feature". `exterior` is called out separately because
/// B-067's launch gate is specifically about having one.
enum FacilityPhotoKind {
  exterior
  gate
  hallway
  unit
  security
  other
}

/// PRD 02 §4.6 US-25 (B-056). A facility's delinquency timeline, versioned.
///
/// Append-only, like message templates and tax components: activating a new
/// configuration inserts a version and deactivates the previous one. Nothing is
/// ever edited in place, because **the lease records which version governed
/// it** (US-25's own AC) — and a lien file whose timeline has been rewritten
/// since is a lien file that cannot be defended.
model DelinquencyTimeline {
  id         String   @id @default(cuid())
  facilityId String
  version    Int
  active     Boolean  @default(false)
  /// What the operator called this revision: "after the 2026 attorney review".
  label      String
  /// US-25's AC: paying this halts the pipeline.
  qualifyingAmount String @default("full_balance")
  /// The steps, as an ordered array of the shape in
  /// packages/core/delinquency. JSON rather than a table: a version is
  /// immutable once activated, so there is nothing to update in place and
  /// nothing joins to an individual step.
  steps      Json
  createdByStaffId String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  facility       Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdByStaff StaffUser? @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)
  leases         Lease[]

  @@unique([facilityId, version])
  @@index([facilityId, active])
  @@map("delinquency_timeline")
  stepRuns DelinquencyStepRun[]
  auctionCases AuctionCase[]
}

/// PRD 02 FR-5 / US-28 (B-057). One row per timeline step executed against one
/// lease.
///
/// This is the step history US-28 requires an auction to be defensible from —
/// "each step, date executed, proof" — so it is a table rather than an event
/// payload, and it is what makes the nightly run idempotent: the unique
/// constraint below is the reason a catch-up over a missed week cannot send the
/// day-15 notice seven times.
model DelinquencyStepRun {
  id         String   @id @default(cuid())
  leaseId    String
  facilityId String
  /// The version that governed this step. Denormalised from the lease because
  /// the lease's pin can be cleared on cure, and the history must not lose
  /// which configuration was in force when the notice went out.
  timelineId String
  /// The step's `dayOffset`, which is its identity within a timeline.
  dayOffset  Int
  label      String
  /// The facility-local day it ran, for "what happened on the 3rd".
  businessDate DateTime @db.Date
  /// The staff task raised, when the step asked for one.
  taskId     String?
  /// What ran, and what did not: `{ actions: [...], skipped: [...] }`. A step
  /// whose notice could not be sent is evidence too, and losing it would make
  /// the history read as if everything worked.
  outcome    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  lease    Lease               @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  facility Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  timeline DelinquencyTimeline @relation(fields: [timelineId], references: [id], onDelete: Restrict)

  /// Set when the tenant cured. The row STAYS — it is the evidence US-28 needs
  /// — but it stops counting as executed, so a lease that falls behind again
  /// starts the pipeline from the beginning rather than resuming at day 30.
  supersededAt DateTime? @db.Timestamptz(6)

  /// Idempotency lives in a PARTIAL unique index, in raw SQL, because Prisma
  /// cannot express one (migration 20260810100000_step_run_episode):
  ///   delinquency_step_run_open_episode — unique(leaseId, dayOffset)
  ///                                       where "supersededAt" is null
  /// Same device as `reservation_one_held_per_unit`. A plain unique on
  /// (leaseId, dayOffset) would make a second delinquency unrunnable.
  @@index([leaseId, supersededAt])
  @@index([facilityId, businessDate])
  @@map("delinquency_step_run")
}

/// PRD 03 US-3 AC1 / PRD 02 US-25 (B-058). A physical overlock on a unit.
///
/// The lock itself is manual — PRD 03's non-goals are explicit that this system
/// never actuates one — so this row is the RECORD that staff fitted it, and the
/// thing `deriveUnitStatus` reads to make a unit `overlocked`. Until now
/// `overlocked` was a status the code could produce and nothing ever did; the
/// comment in `occupancyFactsForMany` said so and named this item.
///
/// Append-only in effect: removal sets `removedAt` rather than deleting, for
/// the same reason the step history is superseded rather than dropped. "Was
/// this unit locked on the day of the sale" is a question an auction turns on.
model UnitOverlock {
  id         String   @id @default(cuid())
  unitId     String
  leaseId    String
  facilityId String
  /// The task that asked for it, so the photo and the note are reachable from
  /// the lock rather than only from the queue.
  appliedTaskId String?
  appliedAt     DateTime? @db.Timestamptz(6)
  appliedByStaffId String?
  removedTaskId String?
  removedAt     DateTime? @db.Timestamptz(6)
  removedByStaffId String?
  /// Why it was fitted: the timeline step's label, so the record reads without
  /// a join.
  reason     String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  lease    Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  /// One live overlock per unit. A partial unique index in raw SQL (Prisma
  /// cannot express one) — migration 20260810120000_unit_overlock:
  ///   unit_overlock_one_live_per_unit — unique(unitId) where "removedAt" is null
  @@index([facilityId, removedAt])
  @@index([leaseId])
  @@map("unit_overlock")
}

enum MaintenanceTicketStatus {
  open
  in_progress
  blocked
  done
}

/// PRD 02 §4.9 US-37 (B-060). A ticket against a unit: raised from the daily
/// walkthrough, from the units board, or directly, tracked to close.
///
/// `blocksAvailability` is the ticket's own flag, not implied by status —
/// "the paint is chipped" and "the roof leaks" can both be `open`, and only
/// one of them should stop the unit from being rented out from under a
/// contractor. Enforced in `canSetManualStatus` (packages/core/inventory),
/// the one place a unit's status may be hand-set (US-8).
model MaintenanceTicket {
  id            String                  @id @default(cuid())
  facilityId    String
  unitId        String
  title         String
  notes         String?
  status        MaintenanceTicketStatus @default(open)
  priority      TaskPriority            @default(normal)
  blocksAvailability Boolean            @default(true)
  /// 'walkthrough' or 'manual' — the AC's "create from walkthrough, unit page,
  /// or manually" made queryable. Not itself functional.
  source        String
  /// Historical only, same as `UnitOverlock.appliedByStaffId` — not a relation,
  /// so nothing about a closed ticket changes if the reporting staffer's
  /// record ever does.
  createdByStaffId String?
  assigneeStaffId  String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  resolvedAt    DateTime? @db.Timestamptz(6)

  facility Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  unit     Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  /// Unlike `createdByStaffId`, a live relation — "assign, prioritize, track
  /// status" (US-37) means this list is read by assignee, so it needs the join
  /// Task's own assignee gets.
  assignee StaffUser? @relation("MaintenanceTicketAssignee", fields: [assigneeStaffId], references: [id], onDelete: Restrict)

  @@index([facilityId, status])
  @@index([unitId, status])
  @@map("maintenance_ticket")
}

/// PRD 04 FR-SEO-2 (B-066). The 301 map.
///
/// "301 redirect map maintained for renamed/retired slugs; facility slug
/// changes auto-create redirects." A slug that has ever been public has been
/// linked to, indexed, and printed on something. Changing it without a redirect
/// throws away every link pointing at the old one and hands a renter a 404 —
/// which is the single most expensive SEO mistake available, because it is
/// invisible until traffic has already gone.
model UrlRedirect {
  id String @id @default(cuid())
  /// The path that no longer resolves, lower-cased, no trailing slash, no
  /// query. Canonical form per `canonicalPath`, so a lookup is one indexed
  /// equality check on the edge rather than a scan with normalisation.
  fromPath String @unique
  /// Where to send them. Relative, so the map survives a domain change.
  toPath   String
  /// 301 by default. 302 exists for a genuinely temporary move; a permanent
  /// redirect is cached by browsers effectively forever and is very hard to
  /// take back, so choosing it is a decision rather than a default nobody saw.
  permanent Boolean @default(true)
  /// Why, for whoever finds this in two years. "facility slug changed",
  /// "facility retired — nearest city page".
  reason    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([fromPath])
  @@map("url_redirect")
}

model SimulatedGateCode {
  id           String   @id @default(cuid())
  facilityId   String
  credentialId String   @unique
  code         String
  active       Boolean  @default(true)
  /// The vendor's copy of the time window (PRD 03 US-4 AC2). Held HERE, on the
  /// simulated controller's own row, rather than read from `Facility` at
  /// keypad time — because a real vendor enforces the window from what it was
  /// last told, and a simulator that peeked at our database would never
  /// reproduce the one bug this design has: a schedule edited but never
  /// propagated. Null means no window was ever pushed: unrestricted.
  windowSchedule Json?
  /// Mirrors `AccessGrant.extendedHours`, for the same reason.
  windowExempt   Boolean @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, code])
  @@map("simulated_gate_code")
}

/// PRD 03 US-7 AC3's "webhook delivery failure" and "event backlog replay".
/// What the mock vendor has generated but not necessarily gotten to us yet —
/// the queue on the OTHER side of the boundary from `GateCommand`, which is
/// ours.
model SimulatedVendorEvent {
  id            String   @id @default(cuid())
  facilityId    String
  vendorEventId String   @unique
  payload       Json
  delivered     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, delivered])
  @@map("simulated_vendor_event")
}

/// PRD 03 US-7 AC3. Per-facility fault injection, toggled from the dev keypad
/// page. `offline` and `latencyMs` affect the outbound command adapter
/// (B-027's queue does the rest); `webhookFailing` affects whether a simulated
/// event actually reaches our webhook.
model GateSimulatorConfig {
  facilityId     String   @id
  offline        Boolean  @default(false)
  latencyMs      Int      @default(0)
  webhookFailing Boolean  @default(false)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("gate_simulator_config")
}

model StripeEvent {
  /// Stripe's `evt_...` id, used directly as the primary key.
  id          String    @id
  type        String
  /// Null until handled. A row with this unset is an event we accepted but
  /// could not process — the thing a reconciliation report looks for.
  processedAt DateTime? @db.Timestamptz(6)
  /// Set when handling failed, so a retry has something to explain itself with.
  error       String?
  /// The event body as Stripe sent it. Kept for replay and for disputes; card
  /// data never appears in it.
  payload     Json
  receivedAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([processedAt])
  @@map("stripe_event")
}

model LedgerEntry {
  id           String          @id @default(cuid())
  facilityId   String
  leaseId      String
  type         LedgerEntryType
  /// Signed cents. Charges and refunds increase the balance; payments,
  /// credits and write-offs decrease it.
  amountCents  Int
  description  String
  occurredAt   DateTime        @default(now()) @db.Timestamptz(6)
  invoiceId    String?
  paymentId    String?
  reversalOfId String?         @unique
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)

  facility   Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  lease      Lease        @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  invoice    Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment    Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reversalOf LedgerEntry? @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy LedgerEntry? @relation("LedgerReversal")

  @@index([leaseId, occurredAt])
  @@index([facilityId, occurredAt])
  @@map("ledger_entry")
}

// --------------------------------------------------------------- access ----

/// One grant per tenant × facility (PRD 03 FR-1).
/// PRD 03 FR-1: "One AccessGrant per credential holder × facility — the
/// tenant is one holder, and each authorized person on one of that tenant's
/// leases is another (US-9)."
///
/// `tenantId` and `authorizedPersonId` are both nullable and exactly one is
/// ever set — the holder is whichever one is not null. Prisma's schema
/// language cannot express "exactly one of two columns," so that is a raw SQL
/// CHECK constraint (migration 20260802110000_authorized_access), the same
/// posture as this project's other cross-field invariants. Both FKs stay
/// plain (not partial-unique) rather than a partial index, because Postgres
/// already treats multiple NULLs in a unique/compound-unique index as
/// distinct — a tenant grant and any number of authorized-person grants at
/// the same facility never collide on `tenantId` being null.
model AccessGrant {
  id                 String           @id @default(cuid())
  facilityId         String
  tenantId           String?
  authorizedPersonId String?          @unique
  state              AccessGrantState @default(pending)
  /// Why the grant last changed, e.g. "system:move_in", "staff:<userId>".
  stateCause         String?
  /// PRD 03 US-4 AC3. 24-hour access, sold as a paid add-on: this grant
  /// ignores the facility's gate hours.
  ///
  /// A boolean rather than a per-grant schedule. "24h access" is the product a
  /// storage facility actually sells; a second full schedule per tenant would
  /// be a configuration surface with no customer behind it, and every one of
  /// them would drift out of step with the facility's own hours.
  extendedHours      Boolean          @default(false)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  facility         Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  tenant           Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  authorizedPerson AuthorizedAccessPerson? @relation(fields: [authorizedPersonId], references: [id], onDelete: Restrict)
  credentials      AccessCredential[]

  @@unique([facilityId, tenantId])
  @@index([facilityId, state])
  @@map("access_grant")
}

model AccessCredential {
  id         String                @id @default(cuid())
  facilityId String
  grantId    String
  leaseId    String?
  type       AccessCredentialType  @default(pin)
  /// The gate code, encrypted at rest (AES-256-GCM, `lib/access/secret.ts`) —
  /// never plaintext, and never merely an inert reference the way earlier
  /// revisions of this comment described. PRD 03 SR-2 wants viewing the real
  /// code to be a separate, audited, default-masked action; that is only
  /// possible if something can eventually decrypt it back. Format is
  /// `enc:<ciphertext>` when a real encryption key is configured, or
  /// `unrevealable:<opaque>` when it is not (same degrade-honestly posture as
  /// an unconfigured Stripe key) — `revealCode()` checks the tag rather than
  /// guessing.
  valueRef   String
  /// SHA-256 of the plaintext code, scoped to the facility. Not a secret in
  /// itself — a 6-digit keyspace is brute-forceable regardless — it exists so
  /// FR-2's "uniqueness scope" can be enforced with an indexed lookup instead
  /// of decrypting every active credential at the facility on each issuance.
  /// Nullable only because it postdates rows created before this column
  /// existed; every credential `issueCredential` creates from here on sets it.
  codeHash   String?
  state      AccessCredentialState @default(active)
  syncStatus HardwareSyncStatus    @default(pending)
  lastSyncAt DateTime?             @db.Timestamptz(6)
  createdAt  DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime              @updatedAt @db.Timestamptz(6)

  facility Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  grant    AccessGrant   @relation(fields: [grantId], references: [id], onDelete: Cascade)
  lease    Lease?        @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  events   AccessEvent[]

  @@index([facilityId, state])
  @@index([grantId])
  @@index([facilityId, codeHash])
  @@map("access_credential")
}

/// PRD 03 US-9. A named person on a lease who gets their own gate credential —
/// never a copy of the tenant's code. Deliberately not a `Tenant`: they have no
/// account, no email identifier, no lease of their own (FR-5.1's tenant
/// concept does not fit them), and they exist only in the context of one
/// lease.
///
/// Staff-managed at MVP (AC4) — there is no portal self-service caller yet,
/// and none of these fields are customer-editable. The admin screen that
/// manages this list is B-038's (the tenant/lease profile does not exist
/// yet); this item ships the model and the service underneath it, the same
/// split B-096 used for lease holds.
model AuthorizedAccessPerson {
  id               String    @id @default(cuid())
  facilityId       String
  leaseId          String
  name             String
  phone            String
  relationship     String
  /// Optional per AC1. A `WeeklySchedule`-shaped JSON when set, reusing the
  /// validated shape facility hours already use (`parseWeeklySchedule`) rather
  /// than inventing a second one. Nothing enforces it yet — gate-hours
  /// enforcement including per-grant overrides is FR-5 / B-064's — so this is
  /// captured and unread until that item exists.
  accessHours      Json?
  active           Boolean   @default(true)
  createdByStaffId String
  revokedAt        DateTime? @db.Timestamptz(6)
  revokedByStaffId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  facility Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  lease    Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  grant    AccessGrant?

  @@index([facilityId, leaseId])
  @@map("authorized_access_person")
}

// ---------------------------------------------------- demand & marketing ----

/// Free hold, no card and no deposit (D-7).
model Reservation {
  id                   String            @id @default(cuid())
  facilityId           String
  unitTypeId           String
  unitId               String?
  tenantId             String?
  leadId               String?
  status               ReservationStatus @default(held)
  firstName            String
  lastName             String
  email                String
  phone                String?
  quotedRateCents      Int
  moveInDate           DateTime?         @db.Timestamptz(6)
  expiresAt            DateTime          @db.Timestamptz(6)
  /// PRD 01 US-801: the 24h-before-expiry reminder, sent at most once. This
  /// column, not the event outbox, is what makes "once" true — the outbox
  /// only dedupes a given event id, and a fresh id would be minted on every
  /// tick a reservation is still inside the reminder window.
  expiryReminderSentAt DateTime?         @db.Timestamptz(6)
  /// Signed-token deep links let a prospect complete or cancel without login
  /// (PRD 01 FR-3.2).
  tokenHash            String            @unique
  /// PRD 02 US-43 (B-097). The acquisition channel, carried from the lead that
  /// produced this hold — or `web` for one a prospect made themselves. Separate
  /// from `utmSource`, which is campaign attribution within the web channel and
  /// says nothing about a call.
  source               String            @default("web")
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  unitType UnitType @relation(fields: [unitTypeId], references: [id], onDelete: Restrict)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  checkoutSessions CheckoutSession[]
  promoRedemptions PromoRedemption[]

  @@index([facilityId, status])
  @@index([status, expiresAt])
  /// Two invariants live in raw SQL because Prisma cannot express a partial
  /// index (migration 20260801090000_reservation_hold_invariants):
  ///   reservation_one_held_per_unit       — unique(unitId) where status='held'
  ///   reservation_expires_after_creation  — CHECK (expiresAt > createdAt)
  @@map("reservation")
}

model Lead {
  id                    String     @id @default(cuid())
  facilityId            String?
  unitTypeId            String?
  tenantId              String?
  status                LeadStatus @default(new)
  /// PRD 02 US-43 (B-097). Where this inquiry came from: `phone`, `walk_in`,
  /// `referral`, `drive_by` for one a staffer took, `web` for a form. Loose
  /// string rather than an enum for the same reason `Document.type` is — a new
  /// channel is a catalog entry, not a migration.
  /// (The column below named `source` already existed and is this.)
  /// When they said they want to move in. Free text on a call becomes a date
  /// here, because "sometime in March" is not something a follow-up can sort by.
  targetMoveInDate      DateTime?  @db.Date
  /// US-43: "a lead not contacted within the facility's configured window
  /// generates a follow-up task... A lead with no disposition is visible, never
  /// silently ageing in `new`." This is what stops the clock.
  contactedAt           DateTime?  @db.Timestamptz(6)
  /// Who took the call. Null for a web form, which nobody took.
  createdByStaffId      String?
  firstName             String?
  lastName              String?
  email                 String?
  phone                 String?
  message               String?
  source                String?
  firstTouchSource      String?
  firstTouchMedium      String?
  firstTouchCampaign    String?
  firstTouchLandingPage String?
  lastTouchSource       String?
  lastTouchMedium       String?
  lastTouchCampaign     String?
  /// PRD 04 FR-LEAD-2 (B-068). Where the last visit landed. First touch has
  /// had one of these since B-002; last touch needs its own, because "which
  /// page were they on when they finally asked" is a different question from
  /// "which page brought them here originally", and they answer to different
  /// spend.
  lastTouchLandingPage  String?
  /// The derived channel (`paid_search`, `organic`, `aggregator`…). Stored
  /// rather than derived on read: the rules will change, and a report of last
  /// quarter must not silently re-file last quarter's leads under this
  /// quarter's rules.
  channel               String?
  /// The `Referer` as sent, kept whole. The channel above is the answer; this
  /// is the evidence, and it is what anyone will want when the answer looks
  /// wrong.
  referrer              String?
  /// Google's click id. Proof of a paid click even when a redirect stripped
  /// the UTM tags — which happens.
  gclid                 String?
  /// PRD 04 US-8 AC1. Which page the form was on.
  landingPage           String?
  /// PRD 04 US-8 AC4's rate limiting, per submitter.
  ///
  /// A keyed SHA-256 of the IP, never the address itself. An IP is personal
  /// data and this needs to answer exactly one question — "has this submitter
  /// been here five times in ten minutes" — which a one-way hash answers just
  /// as well. Keyed rather than plain because the IPv4 space is small enough to
  /// enumerate against an unkeyed digest.
  submitterHash         String?
  /// PRD 04 US-14 (B-072). How far the lead drip has reached: 0 = never
  /// entered, 1–3 = that step has been raised. Stamped by the producer
  /// (consumer for step 1, the nightly job for 2/3) in the same beat as the
  /// event, same device as `Lease.reviewRequestSentAt` — the outbox only
  /// dedupes an event that already exists, so guaranteeing each step fires
  /// once is the producer's job.
  dripStep              Int        @default(0)
  createdAt             DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(6)

  facility       Facility?     @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  unitType       UnitType?     @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdByStaff StaffUser?    @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)
  reservations   Reservation[]
  consents       Consent[]
  activities     LeadActivity[]

  @@index([facilityId, status])
  @@index([facilityId, contactedAt])
  @@index([submitterHash, createdAt])
  /// B-068. Reporting splits leads by acquisition channel over a date range —
  /// the funnel filter and the revenue split both do it. Declared here as well
  /// as created in the migration: `prisma migrate diff` compares the DATABASE
  /// against this model, so an index that exists in one and not the other is
  /// drift, and CI fails on it by design.
  @@index([channel, createdAt])
  @@index([email])
  @@index([phone])
  @@map("lead")
}

/// Definition and eligibility only. Codes, redemptions and the discount hand-off
/// to billing are B-070.
model Promotion {
  id              String               @id @default(cuid())
  name            String
  type            PromotionType
  /// Percent (1–100) for percent_off, cents for amount_off, months for free_months.
  value           Int
  durationPeriods Int                  @default(1)
  status          PromotionStatus      @default(draft)
  displayMode     PromotionDisplayMode @default(auto)
  /// Empty array means every facility / every unit type.
  facilityIds     String[]             @default([])
  unitTypeIds     String[]             @default([])
  newTenantOnly   Boolean              @default(false)
  startsAt        DateTime?            @db.Timestamptz(6)
  endsAt          DateTime?            @db.Timestamptz(6)
  maxRedemptions  Int?
  redemptionCount Int                  @default(0)
  termsText       String?
  /// PRD 04 FR-PROMO-1's min-stay flag. Months a tenant must stay for the
  /// promo to be kept; 0 means no condition. Recorded now and enforced by the
  /// clawback path, which does not exist yet — see the item's own note.
  minStayMonths   Int                  @default(0)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)

  codes       PromoCode[]
  redemptions PromoRedemption[]

  @@index([status])
  @@map("promotion")
}

/// PRD 04 FR-PROMO-2. A code-gated promotion's codes.
///
/// Separate from `Promotion` because one promo can have many codes — a print
/// run, a partner, an influencer — each with its own expiry and its own cap,
/// and "which code brought this in" is the question the whole arrangement
/// exists to answer.
model PromoCode {
  id          String    @id @default(cuid())
  promotionId String
  /// Stored lower-case. FR-PROMO-2: "codes unique, case-insensitive" — folding
  /// at write time is what makes the unique index enforce that, rather than a
  /// case-insensitive lookup that the index cannot help with.
  code        String    @unique
  expiresAt   DateTime? @db.Timestamptz(6)
  maxUses     Int?
  usesCount   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  promotion   Promotion         @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  redemptions PromoRedemption[]

  @@index([promotionId])
  @@map("promo_code")
}

/// PRD 04 FR-PROMO-4. "Created at reservation completion: promo ID, code (if
/// any), reservation ID, facility, discount schedule snapshot."
///
/// The **snapshot** is the point. A percentage of a rent that later changes
/// would silently change what was promised, and a promo edited next quarter
/// must not rewrite what somebody already agreed to. Billing reads this row,
/// never the `Promotion` it came from.
model PromoRedemption {
  id            String  @id @default(cuid())
  promotionId   String
  promoCodeId   String?
  facilityId    String
  reservationId String?
  leaseId       String? @unique
  /// The computed schedule: `[{ periodIndex, amountCents }]`. Whole cents,
  /// resolved against the rate quoted at the time.
  schedule      Json
  /// Sum of the schedule, denormalised so ROI reporting does not have to walk
  /// the JSON of every redemption.
  totalCents    Int
  /// Which periods have actually been discounted on an invoice. Append-only:
  /// billing adds an index when it writes the line, so a re-run of the nightly
  /// job cannot discount the same period twice.
  appliedPeriods Int[]  @default([])
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  promotion   Promotion    @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  promoCode   PromoCode?   @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  lease       Lease?       @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  @@index([promotionId, createdAt])
  @@index([facilityId, createdAt])
  @@map("promo_redemption")
}

/// One consent record per subject × channel. Owned by the shared schema so
/// neither marketing nor comms owns the table (D-8).
model Consent {
  id                String         @id @default(cuid())
  tenantId          String?
  leadId            String?
  channel           ConsentChannel
  state             ConsentState
  /// Where the opt-in happened, e.g. "checkout_step_1", "portal_preferences".
  source            String
  disclosureVersion String?
  ipAddress         String?
  capturedAt        DateTime       @default(now()) @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel])
  @@index([leadId, channel])
  @@map("consent")
}

// ------------------------------------------------------------- comms (PRD 05) ----
//
// The single outbound messaging service (B-030). Producers emit domain events;
// nothing else sends. A rule maps an event to a template, channel and policy;
// the pipeline resolves recipient → suppression/consent → render → provider →
// `Message` log, idempotent by construction (FR-16). Rules and templates are
// data (FR-2), seeded per event/facility by the items that own the content
// (B-031 move-in path, later billing/dunning items) — B-030 ships the engine,
// not the copy.

/// PRD 05 §5.1. Versioned email/SMS template content, org default or per-facility
/// override. New version = new row, never edited in place; the send records the
/// version that rendered it (FR-21).
model MessageTemplate {
  id                  String                @id @default(cuid())
  /// Stable identifier the rules reference, e.g. "move_in_welcome".
  key                 String
  channel             MessageChannel
  classification      MessageClassification
  /// null = org-level default; set = per-facility override.
  facilityId          String?
  version             Int                   @default(1)
  active              Boolean               @default(true)
  /// Email subject; null for SMS.
  subject             String?
  /// Email HTML body; null for SMS (which uses `bodyText` only).
  bodyHtml            String?
  /// Email plaintext part or the SMS body. Always present.
  bodyText            String
  /// Merge fields the render must have a non-empty value for, or it fails loudly
  /// and blocks the send (FR-9, inherits PRD 02 FR-6).
  requiredMergeFields String[]
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([key, channel, facilityId, version])
  @@index([key, channel, facilityId, active])
  @@map("message_template")
}

/// PRD 05 FR-2. Event → template/channel/policy mapping, as data. Org default or
/// per-facility override; the facility-specific rule for a template key wins.
model NotificationRule {
  id             String                @id @default(cuid())
  /// Catalog event name (packages/core/events/catalog.ts) that triggers this.
  event          String
  templateKey    String
  channel        MessageChannel
  channelPolicy  ChannelPolicy         @default(email_only)
  classification MessageClassification
  /// Predicate keys re-evaluated at send time; if any holds, the send is
  /// skipped as stale (FR-18). Resolved by the skip-condition registry.
  skipConditions String[]
  /// Send-time offset the comms service owns within the day (FR-3). 0 = prompt.
  delayMinutes   Int                   @default(0)
  /// null = org default; set = per-facility override.
  facilityId     String?
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([event, active])
  @@index([facilityId])
  @@map("notification_rule")
}

/// PRD 05 FR-21. One send attempt's whole lifecycle, append-only evidence.
/// `eventId`/`ruleId`/`templateKey`/`templateVersion` are snapshotted as plain
/// columns, not FKs, so the log outlives a pruned event or an edited rule.
model Message {
  id                String                @id @default(cuid())
  /// FR-16 hard invariant: hash(eventId, ruleId, recipientId, channel). The
  /// unique constraint is what makes "a tenant is never messaged twice for the
  /// same event" true across retries, redeliveries and job restarts.
  idempotencyKey    String                @unique
  eventId           String
  ruleId            String
  templateKey       String
  templateVersion   Int
  classification    MessageClassification
  channel           MessageChannel
  recipientTenantId String?
  facilityId        String?
  /// The real destination at send time. Masked in admin views (CN-18); stored
  /// whole because the log is the delivery evidence.
  toAddress         String
  subjectSnapshot   String?
  bodySnapshot      String
  status            MessageStatus         @default(queued)
  /// Which consent record authorised an SMS (FR-21). Null for email.
  consentId         String?
  suppressionReason SuppressionReason?
  providerMessageId String?
  error             String?
  sentAt            DateTime?             @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)

  recipient Tenant?   @relation(fields: [recipientTenantId], references: [id], onDelete: SetNull)
  facility  Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([recipientTenantId, createdAt])
  @@index([facilityId, createdAt])
  @@index([status])
  @@map("message")
}

/// PRD 05 §5.1 / CN-20. The shared suppression list (marketing + comms). One
/// entry per channel × address; the pipeline refuses to send to a suppressed
/// address per the classification matrix (hard bounce/complaint block all;
/// unsubscribe/manual block marketing; STOP blocks SMS).
model Suppression {
  id               String            @id @default(cuid())
  channel          MessageChannel
  /// Normalised: lower-cased email, or the phone as stored. Unique per channel.
  address          String
  reason           SuppressionReason
  note             String?
  createdByStaffId String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)

  createdByStaff StaffUser? @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@unique([channel, address])
  @@index([address])
  @@map("suppression")
}

// ----------------------------------------------- documents, staff, audit ----

/// Generated delinquency, lien and rate-change documents. Immutable once
/// generated; all text is draft-only and not legal advice (D-10).
enum NoticeDeliveryMethod {
  certified_mail
  first_class_mail
  hand_delivered
  posted_on_unit
  email
}

/// PRD 02 §4.6 US-27 (B-061). Per-facility lien notice templates.
///
/// A separate table from `MessageTemplate`, deliberately, and it would have
/// been cheaper to reuse that one. Three reasons not to:
///
///  1. A statutory notice is a DOCUMENT, served and evidenced, not an email.
///     It goes through `storeGeneratedDocument` and gets hashed; the comms
///     pipeline's suppression and unsubscribe rules must never apply to it.
///  2. B-063 adds courtesy EMAIL supplements about the same lien stages
///     ("check your mail"), which explicitly never claim to be the statutory
///     notice. Sharing a key namespace with those is how the two get confused.
///  3. B-056's `validateTimeline` checks a step's `noticeTemplateKey` against
///     `MessageTemplate` rows, so a notice template living there would be
///     selectable as a `send_notice` target — quietly emailing the statutory
///     notice through a path with no consent check and no delivery proof.
///
/// Versioned like `MessageTemplate`: new version = new row, never edited in
/// place, and the generated `Notice` records which version rendered it.
model NoticeTemplate {
  id         String     @id @default(cuid())
  type       NoticeType
  /// null = org-level default; set = per-facility override. Same precedence
  /// `effectiveTemplate` applies to messages.
  facilityId String?
  version    Int        @default(1)
  active     Boolean    @default(true)
  title      String
  /// The merge template. Required fields are enforced at save AND at render —
  /// see packages/core/notices/templates.ts.
  body       String
  createdByStaffId String?
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  notices  Notice[]

  @@unique([type, facilityId, version])
  @@index([type, facilityId, active])
  @@map("notice_template")
}

/// PRD 02 §4.6 US-27 / §4.2 US-13. A generated lien notice.
///
/// Immutable once generated. Nothing on a generated row is ever rewritten: a
/// corrected notice is a NEW row with a NEW document and a new date, pointing
/// back at what it corrects (`correctsNoticeId`), and the original is marked
/// superseded rather than edited. Regenerating a PDF at the same URL is the
/// specific failure the backlog names — it destroys the ability to say what was
/// actually sent on the day it was sent.
model Notice {
  id            String       @id @default(cuid())
  facilityId    String
  leaseId       String
  type          NoticeType
  status        NoticeStatus @default(draft)
  generatedAt   DateTime?    @db.Timestamptz(6)
  generatedByStaffId String?

  /// The stored, hashed document (US-16's store). `documentHash` is
  /// denormalised alongside it because US-13's AC asks for the rendered
  /// address and the hash to sit together on THIS row — a lien file should not
  /// need a join to answer "what did you send, and where."
  documentId    String?
  documentUrl   String?
  documentHash  String?
  /// Which template version rendered it (US-27 AC). Kept as an integer as well
  /// as the FK: the row survives a template being deleted, and "version 3" is
  /// what a person asks about.
  noticeTemplateId String?
  templateVersion  Int?

  /// US-13 AC: "Notice generation stores the address it actually rendered on
  /// the `Notice` row alongside the document hash, so 'where did you send it'
  /// is answered by the record." Snapshotted, not joined: the tenant's address
  /// history keeps moving, and this has to keep saying what was on the envelope.
  renderedAddressLine1 String?
  renderedAddressLine2 String?
  renderedCity         String?
  renderedState        String?
  renderedPostalCode   String?
  /// The `TenantAddress` row this was taken from, so the provenance chain runs
  /// notice → address row → who changed it and when.
  tenantAddressId      String?

  /// The itemized claim as it stood at generation, and its total. US-27's
  /// "reconciles to the ledger at generation time" — snapshotted because the
  /// ledger keeps moving and the notice has to keep saying what it said.
  claimSnapshot   Json?
  claimTotalCents Int?
  /// The date the notice gives the tenant to pay by.
  deadlineDate    DateTime? @db.Date

  deliveryMethod NoticeDeliveryMethod?
  deliveredAt    DateTime?             @db.Timestamptz(6)
  /// Tracking numbers, photos, mail receipts — the lien evidence chain.
  deliveryProof Json?

  /// Set on the OLD notice when a correction replaces it.
  supersededAt   DateTime? @db.Timestamptz(6)
  /// Set on the NEW notice, pointing at what it corrects.
  correctsNoticeId String?

  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)

  facility Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  lease    Lease           @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  template NoticeTemplate? @relation(fields: [noticeTemplateId], references: [id], onDelete: Restrict)
  document Document?       @relation(fields: [documentId], references: [id], onDelete: Restrict)
  corrects Notice?         @relation("NoticeCorrection", fields: [correctsNoticeId], references: [id], onDelete: Restrict)
  correctedBy Notice[]     @relation("NoticeCorrection")

  @@index([facilityId, type])
  @@index([leaseId])
  @@index([leaseId, type, supersededAt])
  @@map("notice")
}

// --------------------------------------------------- events & scheduling ----

/// Transactional outbox. Producers write the event in the same transaction as
/// the state change that caused it, so an event can never describe a change
/// that was rolled back — nor can a committed change lose its event.
/// Dispatch is a separate step (PRD 02 FR-7).
model DomainEvent {
  id            String   @id @default(cuid())
  /// Dotted name from the catalog in packages/core/events/catalog.ts.
  name          String
  facilityId    String?
  entityType    String
  entityId      String
  payload       Json
  /// Ties an event to the request or run that produced it.
  correlationId String?
  occurredAt    DateTime @default(now()) @db.Timestamptz(6)

  facility   Facility?       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  deliveries EventDelivery[]

  @@index([name, occurredAt])
  @@index([facilityId, occurredAt])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@map("domain_event")
}

enum DeliveryStatus {
  processing
  succeeded
  failed
  dead_letter
}

/// One row per (event, consumer). The unique constraint is the claim: two
/// workers cannot both take the same delivery, so a consumer sees each event
/// once per attempt rather than once per worker.
///
/// Delivery is at-least-once, not exactly-once — a handler that succeeds and
/// then crashes before its row is marked will run again. Consumers must be
/// idempotent; that is the contract, not an aspiration.
model EventDelivery {
  id            String         @id @default(cuid())
  eventId       String
  /// Stable consumer name. Renaming one replays every past event to it.
  consumer      String
  status        DeliveryStatus @default(processing)
  attempts      Int            @default(0)
  lastError     String?
  /// Null once the delivery is settled; set to a backoff time while retrying.
  nextAttemptAt DateTime?      @db.Timestamptz(6)
  claimedAt     DateTime       @default(now()) @db.Timestamptz(6)
  completedAt   DateTime?      @db.Timestamptz(6)

  event DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, consumer])
  @@index([status, nextAttemptAt])
  @@index([consumer, status])
  @@map("event_delivery")
}

enum JobRunStatus {
  running
  succeeded
  failed
  /// Finished, but at least one item inside it failed (PRD 02 FR-4 wants
  /// per-item outcomes, not just a pass/fail for the run).
  partial
}

/// One row per (job, facility, business date). The unique constraint makes a
/// nightly run idempotent: a second attempt for the same date finds the row
/// instead of doing the work twice, and catch-up after downtime is just
/// running the missing dates.
model JobRun {
  id           String       @id @default(cuid())
  jobName      String
  facilityId   String?
  /// The facility-local calendar date this run is *for*, which is not the same
  /// as when it executed. Stored as a date, deliberately without a timezone.
  businessDate DateTime     @db.Date
  status       JobRunStatus @default(running)
  startedAt    DateTime     @default(now()) @db.Timestamptz(6)
  finishedAt   DateTime?    @db.Timestamptz(6)
  itemsOk      Int          @default(0)
  itemsFailed  Int          @default(0)
  /// Per-item outcomes for the Billing Runs screen (B-043).
  details      Json?
  lastError    String?

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([jobName, facilityId, businessDate])
  @@index([jobName, startedAt])
  @@index([facilityId, startedAt])
  @@map("job_run")
}

// ----------------------------------------------------------------- rbac ----

/// Roles are rows, not an enum, so adding one is configuration rather than a
/// code change (master PRD §7.1). Seeded idempotently by prisma/seed.ts.
model Role {
  id          String  @id @default(cuid())
  /// Stable identifier used in code, e.g. "manager". Never renamed.
  key         String  @unique
  name        String
  description String?
  /// Ordering for "escalate to the next role up" (PRD 02 RBAC-2). Higher wins.
  rank        Int
  /// False for `tenant`, which is granted by session audience rather than by
  /// a facility assignment.
  isStaffRole Boolean @default(true)

  // Monetary authority, configured per role at the org level (PRD 02 RBAC-2).
  // null means unlimited; 0 means no authority at all.
  maxFeeWaiverCents Int?
  maxRefundCents    Int?
  maxCreditCents    Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  permissions RolePermission[]
  assignments StaffFacilityAssignment[]

  @@index([rank])
  @@map("role")
}

/// The permission catalog. Also data — a new capability is a seeded row plus
/// the check that references it.
model Permission {
  key         String  @id
  name        String
  description String?
  /// Grouping for the admin UI, e.g. "billing", "inventory".
  category    String

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId        String
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permission")
}

/// A staff user holds exactly one role per facility assignment, and may be
/// assigned to one, several, or all facilities (PRD 02 §3). A null facilityId
/// means all facilities, present and future.
model StaffFacilityAssignment {
  id          String   @id @default(cuid())
  staffUserId String
  roleId      String
  facilityId  String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  facility  Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, facilityId])
  @@index([facilityId])
  @@index([staffUserId])
  @@map("staff_facility_assignment")
}

// ----------------------------------------------------------------- auth ----

/// Single-use, expiring tokens for magic-link sign-in and password reset
/// (PRD 01 FR-5.2). Only the SHA-256 of the token is stored, so a database
/// leak does not hand out working links.
model AuthToken {
  id        String           @id @default(cuid())
  tokenHash String           @unique
  purpose   AuthTokenPurpose
  audience  AuthAudience
  /// Tenant.id or StaffUser.id. Not a foreign key: the two audiences live in
  /// different tables and the token is useless without a matching email.
  subjectId String
  email     String
  expiresAt DateTime         @db.Timestamptz(6)
  usedAt    DateTime?        @db.Timestamptz(6)
  ipAddress String?
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  @@index([subjectId, purpose])
  @@index([expiresAt])
  @@map("auth_token")
}

/// Feeds the login throttle. Rows are written for successes too, so a
/// successful sign-in can clear the counter for that identity.
/// PRD 05 CN-4 / FR-12. A one-tap way to pay from a reminder, without a
/// password.
///
/// Deliberately NOT an `AuthToken`. Those are single-use, short-lived and grant
/// a full session; this is multi-use for a week, revocable, tracked for
/// attribution, and grants access to exactly one screen for exactly one lease.
/// Overloading the auth token would have meant either weakening it for every
/// other purpose or carrying four nullable columns on it that only one purpose
/// reads.
///
/// The plaintext token is never stored — only its SHA-256, the same discipline
/// as `AuthToken.tokenHash`. A leaked database gives an attacker no working
/// links.
model PayLink {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  tenantId       String
  leaseId        String
  /// The event that produced the message carrying this link. CN-4's
  /// attribution: "payment completed via a deep link is attributed to the
  /// originating message in the send log". Joined to `Message.eventId` rather
  /// than holding a message id, because the link is minted while the body is
  /// being rendered and the Message row does not exist yet.
  eventId        String?
  expiresAt      DateTime  @db.Timestamptz(6)
  /// Set on move-out, and by any later staff action that needs to kill a link.
  revokedAt      DateTime? @db.Timestamptz(6)
  firstClickedAt DateTime? @db.Timestamptz(6)
  lastClickedAt  DateTime? @db.Timestamptz(6)
  clickCount     Int       @default(0)
  /// The payment made through this link. The other half of CN-4's attribution,
  /// and the number that proves the module earns its keep (PRD 05 §7).
  paymentId      String?   @unique
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lease   Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([leaseId, expiresAt])
  @@index([eventId])
  @@map("pay_link")
}

/// PRD 02 §4.4 US-42 (B-096). A reason automated collections stop on a lease.
///
/// The effects are NOT stored here — they are declared per type in
/// `packages/core/holds`, because US-42 requires that adding a hold type be a
/// configuration change rather than six code changes. This row records the
/// fact and the evidence; the catalog says what it does.
model LeaseHold {
  id            String    @id @default(cuid())
  leaseId       String
  /// One of `packages/core/holds`' types. A string rather than an enum so a new
  /// type is a catalog entry and a seed, not a migration.
  type          String
  effectiveFrom DateTime  @db.Timestamptz(6)
  /// Null means open-ended, which is the common case — a bankruptcy ends when
  /// someone learns it has, not on a date known in advance.
  effectiveTo   DateTime? @db.Timestamptz(6)
  reason        String
  /// US-16's document store: the deployment order, the bankruptcy notice.
  documentId    String?
  placedByStaffId String
  liftedAt      DateTime? @db.Timestamptz(6)
  liftedByStaffId String?
  liftReason    String?
  /// US-42: "the `deceased` type records an estate contact". Held on the hold
  /// rather than the tenant because it is true for as long as the hold is, and
  /// a dead tenant's record should not acquire a second live contact.
  estateContactName  String?
  estateContactPhone String?
  estateContactEmail String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  lease         Lease      @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  placedByStaff StaffUser  @relation("HoldPlacedBy", fields: [placedByStaffId], references: [id], onDelete: Restrict)
  liftedByStaff StaffUser? @relation("HoldLiftedBy", fields: [liftedByStaffId], references: [id], onDelete: Restrict)

  @@index([leaseId, liftedAt])
  @@map("lease_hold")
}

model LoginAttempt {
  id          String       @id @default(cuid())
  email       String
  audience    AuthAudience
  ipAddress   String?
  succeeded   Boolean
  attemptedAt DateTime     @default(now()) @db.Timestamptz(6)

  @@index([email, audience, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("login_attempt")
}

/// Staff identity. Role assignments and facility scoping are B-004; MFA is B-079.
model StaffUser {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String?
  emailVerifiedAt DateTime?       @db.Timestamptz(6)
  firstName       String
  lastName        String
  status          StaffUserStatus @default(active)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?       @db.Timestamptz(6)

  auditLogs      AuditLog[]
  assignments    StaffFacilityAssignment[]
  suppressions   Suppression[]
  tenantNotes    TenantNote[]
  paymentsTaken  Payment[]
  holdsPlaced    LeaseHold[] @relation("HoldPlacedBy")
  holdsLifted    LeaseHold[] @relation("HoldLiftedBy")
  tasksAssigned  Task[]                    @relation("TaskAssignee")
  tasksCompleted Task[]                    @relation("TaskCompletedBy")
  maintenanceTicketsAssigned MaintenanceTicket[] @relation("MaintenanceTicketAssignee")

  @@map("staff_user")
  leadsCreated       Lead[]
  delinquencyTimelines DelinquencyTimeline[]
}

enum TaskStatus {
  open
  completed
  cancelled
}

enum TaskPriority {
  normal
  high
}

/// PRD 02 §4.9 US-41 (B-095). "One task queue, not seven": every backlog item
/// that needs staff to see and act on something — a failed downstream step, a
/// stale address, an overlock mismatch, a delinquency step due today — writes
/// a row here instead of inventing its own table. `type` plus
/// `packages/core/tasks`'s catalog is what tells a generic row what it means
/// and what evidence completing it requires.
model Task {
  id         String   @id @default(cuid())
  facilityId String
  /// Looked up in the catalog (packages/core/tasks) for its label, required
  /// proof fields, and whether completing it needs an audit entry. A loose
  /// string rather than an enum for the same reason `Document.type` is: new
  /// task types are a catalog entry, not a migration.
  type       String
  /// What this task is about, mirroring `Document.subjectType`/`subjectId` —
  /// one pair rather than a nullable FK per possible subject, so the entity
  /// stays one table as new task types add new kinds of subject.
  entityType String
  entityId   String
  /// The facility-local calendar day this task belongs to — when it was
  /// created, not a due date. Half of "idempotent creation" (below) and of
  /// "today's list": a redelivered event on the same business day must not
  /// duplicate the task, and "my day" is exactly the rows whose businessDate
  /// is today.
  businessDate DateTime      @db.Date
  priority     TaskPriority  @default(normal)
  /// Null means anyone at the facility can pick it up.
  assigneeStaffId String?
  status           TaskStatus @default(open)
  /// Free-form per `type`'s required keys (packages/core/tasks). A note field
  /// is universal; a tracking number or a photo reference (once there is a
  /// blob store) are type-specific. Validated against the catalog at
  /// completion time, not by the column.
  proof Json?
  /// The domain event that created this task, if any — lets a redelivered
  /// event find (rather than duplicate) the row it already made, alongside
  /// the (type, entityId, businessDate) uniqueness below.
  sourceEventId      String?
  completedByStaffId String?
  completedAt        DateTime? @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)

  facility    Facility   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  assignee    StaffUser? @relation("TaskAssignee", fields: [assigneeStaffId], references: [id], onDelete: Restrict)
  completedBy StaffUser? @relation("TaskCompletedBy", fields: [completedByStaffId], references: [id], onDelete: Restrict)

  // The idempotency key US-41 asks for: a redelivered event that would create
  // the same (type, entityId) on the same business day is a no-op, not a
  // duplicate row in someone's list.
  @@unique([type, entityId, businessDate])
  @@index([facilityId, status, businessDate])
  @@index([assigneeStaffId, status])
  @@map("task")
}

/// Append-only. Every privileged action lands here with before/after values
/// (master PRD §7.1). Nothing in the app updates or deletes a row.
model AuditLog {
  id            String    @id @default(cuid())
  facilityId    String?
  actorType     ActorType
  actorStaffId  String?
  /// Set when the actor is a tenant or an external system rather than staff.
  actorLabel    String?
  entityType    String
  entityId      String
  action        String
  before        Json?
  after         Json?
  reasonCode    String?
  correlationId String?
  occurredAt    DateTime  @default(now()) @db.Timestamptz(6)

  // Restrict, not SetNull: nulling the column on a parent delete is an UPDATE,
  // and the append-only triggers reject those. A facility or staff user with
  // audit history therefore cannot be hard-deleted — which is the intended
  // outcome, since both are soft-deleted in normal operation (PRD 02 FR-10).
  facility   Facility?  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  actorStaff StaffUser? @relation(fields: [actorStaffId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([facilityId, occurredAt])
  @@index([correlationId])
  // Filters required by PRD 02 US-38: by actor, entity, action, and date.
  @@index([actorStaffId, occurredAt])
  @@index([action, occurredAt])
  @@index([occurredAt])
  @@map("audit_log")
}

// ------------------------------------------------------------ auctions ----

enum AuctionStatus {
  eligible
  scheduled
  sold
  cancelled
}

enum SurplusDisposition {
  no_surplus
  held
  claimed
  remitted
}

/// PRD 02 §4.6 US-28 (B-062). One lien-sale case against one lease.
///
/// The spine of the auction pipeline, and the record a wrongful-sale complaint
/// is answered from. Everything the AC lists that is a single fact about the
/// sale lives here; the two things that are lists of their own (advertising
/// runs, and the itemised inventory) are a separate table and a hashed
/// `Document` respectively.
///
/// Append-mostly. `cancelledAt`, the sale outcome and the surplus disposition
/// are each written once and never rewritten — a case that was cancelled and
/// then re-opened is a NEW case, because "was this unit under a live lien case
/// on the 3rd" has to stay answerable.
model AuctionCase {
  id         String        @id @default(cuid())
  facilityId String
  leaseId    String
  unitId     String
  status     AuctionStatus @default(eligible)

  /// US-29: "shows the configured timeline summary on every auction approval
  /// screen." Pinned to the version that governed this case, so a timeline
  /// edited next quarter cannot change what the approval screen said.
  timelineId String?

  /// US-28's vehicle carve-out. Titled property follows a different notice and
  /// sale route in Texas and most states, so this HARD-BLOCKS the standard
  /// path — there is no override anywhere in the codebase.
  containsVehicle Boolean @default(false)
  vehicleNote     String?

  /// Regional or owner approval, required before scheduling.
  approvedByStaffId String?
  approvedAt        DateTime? @db.Timestamptz(6)

  /// A facility-local calendar day: the sale is "on the 14th".
  scheduledSaleDate DateTime? @db.Date

  /// Lock cut and inventory. "The primary evidence that you sold what you said
  /// you sold" — so the itemised inventory and its photographs are rendered
  /// into a hashed `Document` (US-27's mechanism), not free text on this row.
  lockCutAt          DateTime? @db.Timestamptz(6)
  lockCutByStaffId   String?
  oldLockDisposition String?
  inventoryDocumentId String?

  /// Sale outcome. Every figure below is computed by the waterfall
  /// (packages/core/auctions) and posted as ledger entries — never typed in as
  /// a total.
  soldAt              DateTime? @db.Timestamptz(6)
  grossProceedsCents  Int?
  saleCostsCents      Int?
  costsRecoveredCents Int?
  appliedToLienCents  Int?
  surplusCents        Int?
  deficiencyCents     Int?

  /// Buyer record (US-28). A sales-tax return on auction proceeds cannot be
  /// filed without it, so it is required at the moment the sale is recorded
  /// rather than chased afterwards.
  buyerName             String?
  buyerAddressLine1     String?
  buyerAddressLine2     String?
  buyerCity             String?
  buyerState            String?
  buyerPostalCode       String?
  /// A REFERENCE, never the number itself — see the note on redaction in
  /// packages/core/audit. Storing a driving licence number would create a
  /// breach-notification liability for a field nobody needs to read back.
  buyerGovernmentIdReference String?
  buyerTaxExempt             Boolean @default(false)
  buyerResaleCertificateReference String?
  buyerPaymentMethod         String?
  buyerCleanoutDeadline      DateTime? @db.Date
  buyerForfeitTerms          String?

  /// Surplus: a liability with a statutory life, not revenue.
  surplusDisposition     SurplusDisposition @default(no_surplus)
  surplusHoldUntil       DateTime?          @db.Date
  surplusTenantNotifiedAt DateTime?         @db.Timestamptz(6)
  surplusDispositionNote String?
  surplusDispositionedAt DateTime?          @db.Timestamptz(6)

  /// "Cancelling a sale (tenant paid) at any point restores the normal
  /// lifecycle and logs the reason."
  cancelledAt     DateTime? @db.Timestamptz(6)
  cancelledReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  facility  Facility             @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  lease     Lease                @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  unit      Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  timeline  DelinquencyTimeline? @relation(fields: [timelineId], references: [id], onDelete: Restrict)
  inventory Document?            @relation(fields: [inventoryDocumentId], references: [id], onDelete: Restrict)
  advertisements AuctionAdvertisement[]

  /// One LIVE case per lease. A partial unique index in raw SQL (Prisma cannot
  /// express one) — migration 20260810030000_auction_case:
  ///   auction_case_one_live_per_lease
  ///     — unique(leaseId) where status in ('eligible','scheduled')
  /// Same device as `unit_overlock_one_live_per_unit`. A plain unique would
  /// make a second lien cycle on the same lease impossible.
  @@index([facilityId, status])
  @@index([leaseId])
  @@index([facilityId, surplusDisposition])
  @@map("auction_case")
}

/// US-28's "advertising record fields (publication/site, dates run)".
///
/// A table rather than columns because a sale is commonly advertised more than
/// once, in more than one place, and "which runs did you place" is a question
/// the file has to answer with a list.
model AuctionAdvertisement {
  id            String   @id @default(cuid())
  auctionCaseId String
  /// Publication or site name.
  publication   String
  /// The facility-local day it ran.
  runDate       DateTime @db.Date
  /// Tear sheet, listing URL, or invoice reference.
  reference     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  auctionCase AuctionCase @relation(fields: [auctionCaseId], references: [id], onDelete: Cascade)

  @@index([auctionCaseId, runDate])
